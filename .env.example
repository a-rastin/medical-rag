# ============================================================
# RAG-Anything + LightRAG Server configuration
# Copy to .env and fill in your NIM key:  cp .env.example .env
# ============================================================

# --- NVIDIA NIM (OpenAI-compatible endpoint) ---
OPENAI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Models (verified working on this NIM account) ---
# Lightning is fast (~1.3s) and returns clean JSON when 'thinking' is disabled
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIM=2048
# Multimodal model used by RAG-Anything to caption images (best-effort)
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Paths ---
WORKING_DIR=./rag_storage
OUTPUT_DIR=./output
DRUGS_DIR=./.drugs

# --- Local NIM adapter proxy (serves lightrag-server) ---
# Disables 'thinking' mode on chat requests so the WebUI answers fast
NIM_PROXY_HOST=127.0.0.1
NIM_PROXY_PORT=9622

# --- LightRAG Server / WebUI (reads these env vars directly) ---
HOST=0.0.0.0
PORT=9621
LLM_BINDING=openai
LLM_BINDING_HOST=http://127.0.0.1:9622/v1
LLM_BINDING_API_KEY=dummy
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://127.0.0.1:9622/v1
EMBEDDING_BINDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_BINDING_API_KEY=dummy
SUMMARY_LANGUAGE=English
MAX_ASYNC=4
LOG_LEVEL=info
