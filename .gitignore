# Virtual environment (892M, regenerable)
venv/

# Secrets
.env

# Runtime state: logs, pid files, server workdirs
logs/
run/
*.log
*.pid

# LightRAG index is committed on purpose: it is the materialised RAG index
# (graph + vectors + KV) and cannot be reproduced byte-identically by
# re-ingesting, since LLM extraction is non-deterministic.

# Cached MinerU PDF parses — regenerable via `ingest --force`
output/

# Raw source files (UpToDate reprints — not redistributable)
resources/*
!resources/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store
