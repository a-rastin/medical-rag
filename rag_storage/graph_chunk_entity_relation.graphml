<edge source="Status migrainosus" target="Variable attacks">
  <data key="d7">1.0</data>
  <data key="d8">Status migrainosus represents severe intractable migraine attacks, while variable attacks refer to migraine attacks that vary in severity and associated symptoms.</data>
