<node id="Diagnostic resolution">
  <data key="d0">Diagnostic resolution</data>
  <data key="d3">chunk-d3b99ec17053435d72311359e33c6696</data>
  <data key="d2">Cerebrovascular imaging is recommended to resolve ambiguity in suspected SAH when suspicion remains after initial evaluation.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711772</data>
