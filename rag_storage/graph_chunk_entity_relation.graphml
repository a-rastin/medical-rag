</edge>
<edge source="Antiemetics" target="QT Prolongation Risk">
  <data key="d7">1.0</data>
  <data key="d8">Other antiemetic medications can cause dose-dependent QT interval prolongation on ECG, which can lead to a life-threatening cardiac arrhythmia.</data>
  <data key="d9">cardiac arrhythmia,safety concern</data>
  <data key="d10">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d11">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d12">1792711478</data>
  <data key="d13"></data>
</edge>
<edge source="Antiemetics" target="Torsades de Pointes">
  <data key="d7">1.0</data>
  <data key="d8">Certain antiemetics may lead to torsades de pointes, a life-threatening cardiac arrhythmia.</data>
  <data key="d9">life-threatening arrhythmia,safety concern</data>
  <data key="d10">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d11">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d12">1792711479</data>
  <data key="d13"></data>
</edge>
<edge source="Antiemetics" target="Congential Long QT Syndrome">
  <data key="d7">1.0</data>
  <data key="d8">These antiemetics should be avoided in patients with congenital long QT syndrome.</data>
  <data key="d9">contraindication,safety concern</data>
  <data key="d10">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d11">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d12">1792711479</data>
  <data key="d13"></data>
</edge>
<edge source="Antiemetics" target="Persistent Corrected QT Interval &gt;500 milliseconds">
  <data key="d7">1.0</data>
  <data key="d8">These antiemetics should be avoided in patients with persistent corrected QT interval &gt;500 milliseconds on ECG.</data>
  <data key="d9">contraindication,safety concern</data>
  <data key="d10">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d11">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d12">1792711479</data>
  <data key="d13"></data>
</edge>
<edge source="Antiemetics" target="Acquired Long QT Syndrome Risk Factors">
  <data key="d7">1.0</data>
  <data key="d8">These antiemetics should be avoided in patients with other risk factors for acquired long QT syndrome.</data>
  <data key="d9">contraindication,safety concern</data>
