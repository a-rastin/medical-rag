</edge>
<edge source="Meningismus" target="Papilledema">
  <data key="d7">1.0</data>
  <data key="d8">Meningismus may indicate conditions like those causing Papilledema, which is indicative of increased ICP.</data>
  <data key="d9">differential diagnosis,signs of increased ICP</data>
  <data key="d10">chunk-62e03c9a26baa74eae064a1bded7c588</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
