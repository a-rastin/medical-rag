  <data key="d13"></data>
</edge>
<edge source="Triptans" target="Ergotamine Preparations">
  <data key="d7">1.0</data>
  <data key="d8">Triptans should not be used within 24 hours of the use of ergotamine preparations.</data>
  <data key="d9">drug interaction,timing restriction</data>
