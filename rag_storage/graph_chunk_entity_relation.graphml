</node>
<node id="LP contraindication">
  <data key="d0">LP contraindication</data>
  <data key="d3">chunk-d3b99ec17053435d72311359e33c6696</data>
  <data key="d2">Immunocompromised state is a criterion for prior CT before lumbar puncture, and LP should not be delayed in its absence.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
