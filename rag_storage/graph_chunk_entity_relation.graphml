</edge>
<edge source="NSAIDs" target="Hemorrhagic Cause of Headache">
  <data key="d7">1.0</data>
  <data key="d8">NSAIDs should be withheld in patients for whom there remains concern for a hemorrhagic cause of headache or who may require a lumbar puncture.</data>
  <data key="d9">clinical precaution,contraindication</data>
  <data key="d10">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
