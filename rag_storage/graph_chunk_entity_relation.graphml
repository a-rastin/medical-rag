<node id="Prior CT requirement">
  <data key="d0">Prior CT requirement</data>
  <data key="d3">chunk-d3b99ec17053435d72311359e33c6696</data>
  <data key="d2">Immunocompromised state is a criterion for prior CT before lumbar puncture.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711772</data>
