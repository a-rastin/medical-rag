</edge>
<edge source="Suspected meningitis or encephalitis" target="Empiric antimicrobial therapy">
  <data key="d7">1.0</data>
  <data key="d8">Empiric antimicrobial therapy should be instituted if bacterial meningitis is considered.</data>
  <data key="d9">infection management,treatment initiation</data>
  <data key="d10">chunk-d3b99ec17053435d72311359e33c6696</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
