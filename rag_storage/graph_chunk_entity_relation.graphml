  <data key="d6"></data>
</node>
<node id="RadiologyInfo.org">
  <data key="d0">RadiologyInfo.org</data>
  <data key="d1">organization</data>
  <data key="d2">RadiologyInfo.org is a resource providing information on radiology safety and procedures.</data>
  <data key="d3">chunk-e0b3b281b34d994290b07d55d736c0fd</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711762</data>
  <data key="d6"></data>
</node>
<node id="Clinical policy: critical issues in the evaluation and management of patients presenting to the emergency department with acute headache">
  <data key="d0">Clinical policy: critical issues in the evaluation and management of patients presenting to the emergency department with acute headache</data>
  <data key="d1">category</data>
  <data key="d2">This clinical policy addresses critical issues in the evaluation and management of acute headache in the emergency department.</data>
  <data key="d3">chunk-e0b3b281b34d994290b07d55d736c0fd</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711762</data>
  <data key="d6"></data>
</node>
<node id="Utility of neuroimaging in the evaluation of headache in patients with normal neurologic examinations">
  <data key="d0">Utility of neuroimaging in the evaluation of headache in patients with normal neurologic examinations</data>
  <data key="d1">category</data>
  <data key="d2">This guideline addresses the utility of neuroimaging in evaluating headache patients with normal neurologic examinations.</data>
  <data key="d3">chunk-e0b3b281b34d994290b07d55d736c0fd</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711762</data>
  <data key="d6"></data>
</node>
<node id="Sudden-Onset Headache">
  <data key="d0">Sudden-Onset Headache</data>
  <data key="d3">chunk-7d7e2a1fa6fae352f798fe0d6e8e0e62</data>
  <data key="d2">Sudden-onset headache reaching maximal intensity within seconds or minutes warrants investigation for subarachnoid hemorrhage.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711762</data>
  <data key="d6"></data>
</node>
<node id="CT or magnetic resonance imaging (MRI) of the head">
  <data key="d0">CT or magnetic resonance imaging (MRI) of the head</data>
  <data key="d3">chunk-62e03c9a26baa74eae064a1bded7c588</data>
  <data key="d2">CT or MRI is the preferred examination for headache with high-risk features.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711763</data>
  <data key="d6"></data>
</node>
<node id="Increased Intracranial Pressure">
  <data key="d0">Increased Intracranial Pressure</data>
  <data key="d3">chunk-62c387dc1abd6c2085428bd5bab9c2b4</data>
  <data key="d2">Intracranial mass lesions are evaluated as a cause of increased intracranial pressure using head MRI or CT.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711763</data>
  <data key="d6"></data>
</node>
<node id="Suspected acute angle-closure glaucoma">
  <data key="d0">Suspected acute angle-closure glaucoma</data>
  <data key="d3">chunk-62c387dc1abd6c2085428bd5bab9c2b4</data>
  <data key="d2">Elevated intraocular pressure confirms the diagnosis, and unnecessary neurologic workup and imaging should be avoided to not delay treatment.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711764</data>
  <data key="d6"></data>
</node>
<node id="Suspected carbon monoxide poisoning">
  <data key="d0">Suspected carbon monoxide poisoning</data>
  <data key="d3">chunk-62c387dc1abd6c2085428bd5bab9c2b4</data>
  <data key="d2">The diagnosis of carbon monoxide poisoning is confirmed by measuring carboxyhemoglobin concentration with cooximetry using an arterial blood gas sample.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711764</data>
  <data key="d6"></data>
</node>
<node id="Elevated Intraocular Pressure">
  <data key="d0">Elevated Intraocular Pressure</data>
  <data key="d3">chunk-62c387dc1abd6c2085428bd5bab9c2b4</data>
  <data key="d2">Elevated intraocular pressure confirms the diagnosis, and unnecessary neurologic workup and imaging should be avoided to not delay treatment.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711764</data>
  <data key="d6"></data>
</node>
<node id="Recent Trauma">
  <data key="d0">Recent Trauma</data>
  <data key="d3">chunk-4b923e6b3f5a46729e0154937dbba3c5</data>
  <data key="d2">Recent trauma, even minor, is a clue for arterial dissection in patients without typical neurologic findings.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711764</data>
  <data key="d6"></data>
</node>
<node id="Focal Neurologic Deficit">
  <data key="d0">Focal Neurologic Deficit</data>
  <data key="d3">chunk-62c387dc1abd6c2085428bd5bab9c2b4</data>
  <data key="d2">Focal neurologic deficit is a clinical sign that should suspect increased intracranial pressure when accompanied by headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711764</data>
  <data key="d6"></data>
</node>
<node id="Repeated Nausea and Vomiting">
  <data key="d0">Repeated Nausea and Vomiting</data>
  <data key="d3">chunk-62c387dc1abd6c2085428bd5bab9c2b4</data>
  <data key="d2">Repeated episodes of nausea and vomiting without another explanation should suspect increased intracranial pressure when accompanied by headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711765</data>
  <data key="d6"></data>
</node>
<node id="Imaging Nondiagnostic">
  <data key="d0">Imaging Nondiagnostic</data>
  <data key="d3">chunk-4b923e6b3f5a46729e0154937dbba3c5</data>
  <data key="d2">If imaging is nondiagnostic, lumbar puncture may be needed to investigate other potential causes, including cryptococcal meningitis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711765</data>
  <data key="d6"></data>
</node>
<node id="Nausea and Vomiting">
  <data key="d0">Nausea and Vomiting</data>
  <data key="d3">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d2">Treating nausea and vomiting with a parenteral agent such as ondansetron may make the patient more comfortable while other diagnostic and therapeutic steps are occurring.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711765</data>
  <data key="d6"></data>
</node>
<node id="Hemorrhagic Cause of Headache">
  <data key="d0">Hemorrhagic Cause of Headache</data>
  <data key="d3">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d2">NSAIDs should be withheld in patients for whom there remains concern for a hemorrhagic cause of headache or who may require a lumbar puncture.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711765</data>
  <data key="d6"></data>
</node>
<node id="Migrainous Features">
  <data key="d0">Migrainous Features</data>
  <data key="d3">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d2">Dihydroergotamine 1 mg IV may be effective for headaches unresponsive to treatment with a combination of NSAID and dopamine antagonist that have some migrainous features.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711765</data>
  <data key="d6"></data>
</node>
<node id="Contraindications to NSAIDs">
  <data key="d0">Contraindications to NSAIDs</data>
  <data key="d3">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d2">The use of injectable opioids is strongly discouraged, but they may be necessary for patients with contraindications to NSAIDs or medications with vasoconstrictive effects.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711765</data>
  <data key="d6"></data>
</node>
<node id="Occipital Neuritis">
  <data key="d0">Occipital Neuritis</data>
  <data key="d3">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d2">Occipital nerve blocks have been shown to be effective analgesia not only for occipital neuritis but also for undifferentiated primary headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711765</data>
  <data key="d6"></data>
</node>
<node id="Imaging">
  <data key="d0">Imaging</data>
  <data key="d3">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d2">CT or MRI of the head is the preferred imaging examination for headache, with choice depending on suspected diagnosis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711765</data>
  <data key="d6"></data>
</node>
<node id="Prochlorperazine and Diphenhydramine">
  <data key="d0">Prochlorperazine and Diphenhydramine</data>
  <data key="d3">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d2">Injectable opioids may be necessary for patients in whom prochlorperazine and diphenhydramine have not been effective.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Undifferentiated Primary Headache">
  <data key="d0">Undifferentiated Primary Headache</data>
  <data key="d3">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d2">Occipital nerve blocks have been shown to be effective analgesia for undifferentiated primary headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Infection (Extracranial)">
  <data key="d0">Infection (Extracranial)</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Infection in an extracranial location such as paranasal or mastoid sinuses, pharynx, or inner ear may serve as a nidus for the development of meningitis or intracranial abscess.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Headache with Seizure">
  <data key="d0">Headache with Seizure</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Headache associated with seizure is also concerning for intracranial pathology.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Past Headache History">
  <data key="d0">Past Headache History</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Patients suffering from migraine usually have had similar headaches in the past, and by definition, one cannot definitively make a diagnosis of migraine without at least four prior episodes.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Postpartum Headache">
  <data key="d0">Postpartum Headache</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Venous sinus thrombosis is most common postpartum.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Contraindications">
  <data key="d0">Contraindications</data>
  <data key="d3">chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d2">The use of injectable opioids is strongly discouraged but may be necessary for patients with contraindications to NSAIDs or vasoconstrictive effects.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Intracranial Abscess">
  <data key="d0">Intracranial Abscess</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Infection in an extracranial location such as paranasal or mastoid sinuses, pharynx, or inner ear may serve as a nidus for the development of meningitis or intracranial abscess.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Visual Disturbances">
  <data key="d0">Visual Disturbances</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Patients with significant ophthalmologic disease, most notably acute angle-closure glaucoma, present with a complaint of headache; A careful history and physical examination, including measurement of intraocular pressures, is usually sufficient to determine whether this is the source of pain.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Intracranial Pathology">
  <data key="d0">Intracranial Pathology</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Headache associated with seizure is also concerning for intracranial pathology.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Pregnancy Headache">
  <data key="d0">Pregnancy Headache</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Less common etiologies include pituitary apoplexy.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Headache Assessment">
  <data key="d0">Headache Assessment</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Location of the pain is a factor in headache assessment, though the text provided was cut off; however, typical associations include specific locations correlating with certain etiologies.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711766</data>
  <data key="d6"></data>
</node>
<node id="Postpartum Seizure">
  <data key="d0">Postpartum Seizure</data>
  <data key="d3">chunk-88449f41c18acfddbc679b10a20feb42</data>
  <data key="d2">Venous sinus thrombosis is most common postpartum.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711767</data>
  <data key="d6"></data>
</node>
<node id="Cough, Valsalva">
  <data key="d0">Cough, Valsalva</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Brain tumor is a high-risk cause of headache that worsens with cough or Valsalva due to elevated ICP.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711767</data>
  <data key="d6"></data>
</node>
<node id="Focal neurologic findings">
  <data key="d0">Focal neurologic findings</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Intracranial hemorrhage is a serious cause of headache associated with focal neurologic findings.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711767</data>
  <data key="d6"></data>
</node>
<node id="Focal neurologic deficits">
  <data key="d0">Focal neurologic deficits</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Stroke is a serious cause of headache associated with focal neurologic deficits.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711767</data>
  <data key="d6"></data>
</node>
<node id="Visual aura">
  <data key="d0">Visual aura</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Migraine can present with visual aura, which is characterized by positive phenomena such as scintillations.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711767</data>
  <data key="d6"></data>
</node>
<node id="Positive phenomena">
  <data key="d0">Positive phenomena</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Table 5 describes positive phenomena that are due to migraine and seizure.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711767</data>
  <data key="d6"></data>
</node>
<node id="Fever">
  <data key="d0">Fever</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">CNS infection is a cause of fever that makes a diagnosis of migraine or tension-type headache unlikely.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711767</data>
  <data key="d6"></data>
</node>
<node id="Severe hypertension">
  <data key="d0">Severe hypertension</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">SAH can manifest as headache, although severe hypertension (diastolic blood pressure ≥120 mmHg) can also manifest as headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711767</data>
  <data key="d6"></data>
</node>
<node id="intracranial bleeding">
  <data key="d0">intracranial bleeding</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Liver disease adversely affects coagulation and may predispose patients to intracranial bleeding.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711767</data>
  <data key="d6"></data>
</node>
<node id="Negative phenomena">
  <data key="d0">Negative phenomena</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Table 5 describes negative findings that are found in destructive lesions.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711768</data>
  <data key="d6"></data>
</node>
<node id="stroke">
  <data key="d0">stroke</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Hypercoagulable states may increase the risk of stroke or cerebral venous thrombosis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711768</data>
  <data key="d6"></data>
</node>
<node id="hypoglycemia">
  <data key="d0">hypoglycemia</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Point-of-care glucose concentration is used to check for hypoglycemia in patients with headache and altered mental status.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711768</data>
  <data key="d6"></data>
</node>
<node id="glucose concentration">
  <data key="d0">glucose concentration</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Fingerstick is a method used for point-of-care glucose concentration testing.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711768</data>
  <data key="d6"></data>
</node>
<node id="cerebral venous thrombosis">
  <data key="d0">cerebral venous thrombosis</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Hypercoagulable states may increase the risk of stroke or cerebral venous thrombosis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711768</data>
  <data key="d6"></data>
</node>
<node id="positive phenomena">
  <data key="d0">positive phenomena</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Table 5 describes positive phenomena that are due to migraine and seizure.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711768</data>
  <data key="d6"></data>
</node>
<node id="Tension-type headache">
  <data key="d0">Tension-type headache</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">CNS infection or inflammation makes a diagnosis of migraine or tension-type headache unlikely.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711768</data>
  <data key="d6"></data>
</node>
<node id="negative phenomena">
  <data key="d0">negative phenomena</data>
  <data key="d3">chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d2">Table 5 describes negative findings that are found in destructive lesions.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711768</data>
  <data key="d6"></data>
</node>
<node id="High-Risk Headache Features">
  <data key="d0">High-Risk Headache Features</data>
  <data key="d3">chunk-d93c3ae2e3eb96980253ed880c4042a8</data>
  <data key="d2">Neurology consultation may facilitate both the acute evaluation and follow-up for patients with high-risk headache features and nondiagnostic testing.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711769</data>
  <data key="d6"></data>
</node>
<node id="Greige T">
  <data key="d0">Greige T</data>
  <data key="d3">chunk-67064a19688d3727bfd01270acdcdada</data>
  <data key="d2">Greige T and Edlow JA co-authored a study on managing acute headache in pregnant and postpartum women.&gt;</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711770</data>
  <data key="d6"></data>
</node>
<node id="Pope JV">
  <data key="d0">Pope JV</data>
  <data key="d3">chunk-67064a19688d3727bfd01270acdcdada</data>
  <data key="d2">Pope JV and Edlow JA co-authored a study on favorable response to analgesics not predicting a benign etiology of headache.&gt;</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711770</data>
  <data key="d6"></data>
</node>
<node id="Involved Eye">
  <data key="d0">Involved Eye</data>
  <data key="d3">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d2">Headache from acute angle-closure glaucoma is commonly centered around the involved eye.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711770</data>
  <data key="d6"></data>
</node>
<node id="Temple">
  <data key="d0">Temple</data>
  <data key="d3">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d2">Headache from giant cell arteritis is often, but not always, focused in a temple.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711770</data>
  <data key="d6"></data>
</node>
<node id="Miner JR">
  <data key="d0">Miner JR</data>
  <data key="d3">chunk-67064a19688d3727bfd01270acdcdada</data>
  <data key="d2">Miner JR and Edlow JA co-authored a study on sumatriptan for the treatment of undifferentiated primary headaches in the ED.&gt;</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711770</data>
  <data key="d6"></data>
</node>
<node id="Swadron SP">
  <data key="d0">Swadron SP</data>
  <data key="d3">chunk-67064a19688d3727bfd01270acdcdada</data>
  <data key="d2">Swadron SP and Edlow JA co-authored a study on pitfalls in the management of headache in the emergency department.&gt;</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711771</data>
  <data key="d6"></data>
</node>
<node id="Stroke Risk">
  <data key="d0">Stroke Risk</data>
  <data key="d3">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d2">A number of illicit drugs, including cocaine, methamphetamine, and other sympathomimetic agents, increase the risk of stroke and intracranial bleeding.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711771</data>
  <data key="d6"></data>
</node>
<node id="McCoy JJ">
  <data key="d0">McCoy JJ</data>
  <data key="d3">chunk-67064a19688d3727bfd01270acdcdada</data>
  <data key="d2">McCoy JJ and Edlow JA co-authored a randomized clinical trial on treatment of headache in the emergency department with haloperidol.&gt;</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711771</data>
  <data key="d6"></data>
</node>
<node id="Intravenous Drug Use">
  <data key="d0">Intravenous Drug Use</data>
  <data key="d3">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d2">If the drugs are used intravenously (IV), brain abscess is another possibility, even in the absence of fever.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711771</data>
  <data key="d6"></data>
</node>
<node id="Risk of Spinal Manipulation">
  <data key="d0">Risk of Spinal Manipulation</data>
  <data key="d3">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d2">Chiropractic neck manipulation.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711771</data>
  <data key="d6"></data>
</node>
<node id="Intracranial Metastasis">
  <data key="d0">Intracranial Metastasis</data>
  <data key="d3">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d2">Malignancy with a risk of intracranial metastasis (and possibly increased intracranial pressure [ICP]).</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711771</data>
  <data key="d6"></data>
</node>
<node id="Aneurysm Risk">
  <data key="d0">Aneurysm Risk</data>
  <data key="d3">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d2">Polycystic kidney disease or connective tissue disease, both of which increase the risk of aneurysms with resultant SAH.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711771</data>
  <data key="d6"></data>
</node>
