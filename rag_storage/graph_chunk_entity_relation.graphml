  <data key="d2">Visser L is a researcher who contributed to a systematic review on parenteral agents for migraine.</data>
  <data key="d3">chunk-9666bb1f91905773a4411559f12b0410</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Meyer J">
  <data key="d0">Meyer J</data>
  <data key="d1">person</data>
  <data key="d2">Meyer J is a researcher who contributed to a systematic review on parenteral agents for migraine.</data>
  <data key="d3">chunk-9666bb1f91905773a4411559f12b0410</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Rothney A">
  <data key="d0">Rothney A</data>
  <data key="d1">person</data>
  <data key="d2">Rothney A is a researcher who contributed to a study on the use of narcotic analgesics in the emergency department treatment of migraine.</data>
  <data key="d3">chunk-9666bb1f91905773a4411559f12b0410</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Wright SC">
  <data key="d0">Wright SC</data>
  <data key="d1">person</data>
  <data key="d2">Wright SC is a researcher who contributed to a study on the use of narcotic analgesics in the emergency department treatment of migraine.</data>
  <data key="d3">chunk-9666bb1f91905773a4411559f12b0410</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Moore RA">
  <data key="d0">Moore RA</data>
  <data key="d1">person</data>
  <data key="d2">Moore RA is a researcher who contributed a Cochrane review on aspirin with or without an antiemetic for acute migraine headaches.&lt;SEP&gt;Moore RA is an author of academic literature on triptans for acute cluster headache.</data>
  <data key="d3">chunk-9666bb1f91905773a4411559f12b0410&lt;SEP&gt;chunk-7cddaa60186a583b48d21588a10557f5</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711574</data>
  <data key="d6"></data>
</node>
<node id="Derry S">
  <data key="d0">Derry S</data>
  <data key="d1">person</data>
  <data key="d2">Derry S is a researcher who contributed a Cochrane review on aspirin with or without an antiemetic for acute migraine headaches.&lt;SEP&gt;Derry S is an author of academic literature on triptans for acute cluster headache.</data>
  <data key="d3">chunk-9666bb1f91905773a4411559f12b0410&lt;SEP&gt;chunk-7cddaa60186a583b48d21588a10557f5</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711574</data>
  <data key="d6"></data>
</node>
<node id="Kirthi V">
  <data key="d0">Kirthi V</data>
  <data key="d1">person</data>
  <data key="d2">Kirthi V is a researcher who contributed a Cochrane review on aspirin with or without an antiemetic for acute migraine headaches.</data>
  <data key="d3">chunk-9666bb1f91905773a4411559f12b0410</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Intranasal Spray Sumatriptan">
  <data key="d0">Intranasal Spray Sumatriptan</data>
  <data key="d1">data</data>
  <data key="d2">Intranasal spray sumatriptan is administered as one insufflation of 5 to 20 mg in a single nostril, with a typical initial dose of 20 mg based on clinical experience and evidence of dose responsiveness.</data>
  <data key="d3">chunk-f034fb31d8b9231647be0271fbbe11ff</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Intranasal Sumatriptan with DDM">
  <data key="d0">Intranasal Sumatriptan with DDM</data>
  <data key="d1">data</data>
  <data key="d2">Intranasal sumatriptan coformulated with DDM is given as a single insufflation of 10 mg in one nostril, designed for more rapid absorption into the systemic circulation.</data>
  <data key="d3">chunk-f034fb31d8b9231647be0271fbbe11ff</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Nasal Powder Sumatriptan">
  <data key="d0">Nasal Powder Sumatriptan</data>
  <data key="d1">data</data>
  <data key="d2">Nasal powder sumatriptan is given as a 22 mg dose using one 11 mg capsule insufflated in each nostril with a breath-powered delivery device.</data>
  <data key="d3">chunk-f034fb31d8b9231647be0271fbbe11ff</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Propranolol">
  <data key="d0">Propranolol</data>
  <data key="d1">data</data>
  <data key="d2">Propranolol is a medication that increases rizatriptan levels by 70 percent, necessitating a dose adjustment of rizatriptan.</data>
  <data key="d3">chunk-f034fb31d8b9231647be0271fbbe11ff</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="DDM">
  <data key="d0">DDM</data>
  <data key="d1">concept</data>
  <data key="d2">DDM is a permeation enhancer used in intranasal sumatriptan coformulation for more rapid absorption into the systemic circulation.</data>
  <data key="d3">chunk-f034fb31d8b9231647be0271fbbe11ff</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Oral Serotonin Agonists">
  <data key="d0">Oral Serotonin Agonists</data>
  <data key="d1">concept</data>
  <data key="d2">Oral serotonin agonists are a class of triptan medications evaluated in a meta-analysis of over 24,000 patients, concluding that all available oral drugs are effective and well tolerated.</data>
  <data key="d3">chunk-f034fb31d8b9231647be0271fbbe11ff</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Aspirin">
  <data key="d0">Aspirin</data>
  <data key="d1">data</data>
  <data key="d2">Aspirin is a medication evaluated for acute migraine headaches, often in combination with or without an antiemetic, as evidenced in clinical studies and Cochrane reviews.</data>
  <data key="d3">chunk-e4bdd16b737b7973c6581c7cc92604b7</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Diclofenac">
  <data key="d0">Diclofenac</data>
  <data key="d1">data</data>
  <data key="d2">Diclofenac is a non-steroidal anti-inflammatory drug (NSAID) evaluated for acute migraine treatment, including formulations like potassium and epolamine salts.</data>
  <data key="d3">chunk-e4bdd16b737b7973c6581c7cc92604b7</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Tolfenamic Acid">
  <data key="d0">Tolfenamic Acid</data>
  <data key="d1">data</data>
  <data key="d2">Tolfenamic acid is a rapid-release medication compared with sumatriptan in the acute treatment of migraine, showing comparable effects.</data>
  <data key="d3">chunk-e4bdd16b737b7973c6581c7cc92604b7</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Celecoxib">
  <data key="d0">Celecoxib</data>
  <data key="d1">data</data>
  <data key="d2">Celecoxib oral solution (DFN-15) was evaluated for efficacy, tolerability, and safety in the acute treatment of episodic migraine in a randomized, double-blind, placebo-controlled study.</data>
  <data key="d3">chunk-e4bdd16b737b7973c6581c7cc92604b7</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Caffeine">
  <data key="d0">Caffeine</data>
  <data key="d1">content</data>
  <data key="d2">Caffeine is frequently combined with analgesics like acetaminophen and aspirin for the alleviation of migraine headache pain.&lt;SEP&gt;Caffeine (250 mg) is combined with ergotamine (2 mg) as a rectal suppository to prevent cluster headache attacks during the night.</data>
  <data key="d3">chunk-e4bdd16b737b7973c6581c7cc92604b7&lt;SEP&gt;chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711569</data>
  <data key="d6"></data>
</node>
<node id="Evidence-based Guidelines">
  <data key="d0">Evidence-based Guidelines</data>
  <data key="d1">concept</data>
  <data key="d2">Evidence-based guidelines exist for the pharmacological treatment of migraine, providing recommendations for primary healthcare providers.</data>
  <data key="d3">chunk-e4bdd16b737b7973c6581c7cc92604b7</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Cochrane Database Systematic Reviews">
  <data key="d0">Cochrane Database Systematic Reviews</data>
  <data key="d1">content</data>
  <data key="d2">Cochrane Database Systematic Reviews compile and analyze data from clinical trials regarding migraine treatments such as aspirin, ibuprofen, and naproxen.</data>
  <data key="d3">chunk-e4bdd16b737b7973c6581c7cc92604b7</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Network Meta-analysis">
  <data key="d0">Network Meta-analysis</data>
  <data key="d1">method</data>
  <data key="d2">Comparative effects of drug interventions for acute migraine management were analyzed using systematic review and network meta-analysis methods.&lt;SEP&gt;Network meta-analysis is a statistical method used to compare multiple treatments simultaneously.</data>
  <data key="d3">chunk-e4bdd16b737b7973c6581c7cc92604b7&lt;SEP&gt;chunk-27dde5a0572eb3184020966c72e61c89</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="NSAID">
  <data key="d0">NSAID</data>
  <data key="d1">content</data>
  <data key="d2">NSAIDs are nonsteroidal anti-inflammatory drugs used for treating acute migraine.</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Sumatriptan-naproxen">
  <data key="d0">Sumatriptan-naproxen</data>
  <data key="d1">content</data>
  <data key="d2">Sumatriptan-naproxen is the best-studied combination for acute migraine treatment.</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Treximet">
  <data key="d0">Treximet</data>
  <data key="d1">artifact</data>
  <data key="d2">Treximet is a single tablet formulation of sumatriptan succinate 85 mg and naproxen sodium 500 mg.</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="QT Prolongation Risk">
  <data key="d0">QT Prolongation Risk</data>
  <data key="d1">data</data>
  <data key="d2">Certain antiemetics can cause dose-dependent QT interval prolongation on ECG, leading to life-threatening arrhythmias.</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="Torsades de Pointes">
  <data key="d0">Torsades de Pointes</data>
  <data key="d1">data</data>
  <data key="d2">Torsades de pointes is a life-threatening cardiac arrhythmia associated with QT prolongation.</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711463</data>
  <data key="d6"></data>
</node>
<node id="UpToDate">
  <data key="d0">UpToDate</data>
  <data key="d1">content</data>
  <data key="d2">UpToDate is a drug interactions program included for additional information on triptan drug interactions.&lt;SEP&gt;UpToDate is a clinical decision support resource providing medical information, Version 63.0, © 2026.&lt;SEP&gt;UpToDate is a clinical decision support resource that provides detailed medical information and guidance.&lt;SEP&gt;UpToDate offers patient education materials relevant to headache treatment and causes.&lt;SEP&gt;UpToDate is a clinical decision support resource providing topic 287 version 41.0 © 2026.&gt;</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0&lt;SEP&gt;chunk-1bcde2da429cc0d5c293fedea4e0af9b&lt;SEP&gt;chunk-469ba9f85eff0d1ef2fc5b0807c28e01&lt;SEP&gt;chunk-764b1321ae6bc951a2c8d2de5901567f&lt;SEP&gt;chunk-67064a19688d3727bfd01270acdcdada</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF&lt;SEP&gt;iMD_Uptodate_Emergency_evaluation_of_the_adult_with_new_nontraumatic.PDF&lt;SEP&gt;iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711755</data>
  <data key="d6"></data>
</node>
<node id="QT Prolongation">
  <data key="d0">QT Prolongation</data>
  <data key="d1">data</data>
  <data key="d2">QT prolongation refers to dose-dependent prolongation of the QT interval on ECG, which can lead to life-threatening arrhythmias.</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711464</data>
  <data key="d6"></data>
</node>
<node id="Congenital Long QT Syndrome">
  <data key="d0">Congenital Long QT Syndrome</data>
  <data key="d1">data</data>
  <data key="d2">Congenital long QT syndrome is a condition where these antiemetics should be avoided.</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711464</data>
  <data key="d6"></data>
</node>
<node id="Persistent Corrected QT Interval &gt;500 milliseconds">
  <data key="d0">Persistent Corrected QT Interval &gt;500 milliseconds</data>
  <data key="d1">data</data>
  <data key="d2">Persistent corrected QT interval &gt;500 milliseconds on ECG is a condition where these antiemetics should be avoided.</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711464</data>
  <data key="d6"></data>
</node>
<node id="Acquired Long QT Syndrome Risk Factors">
  <data key="d0">Acquired Long QT Syndrome Risk Factors</data>
  <data key="d1">data</data>
  <data key="d2">Acquired long QT syndrome risk factors are conditions where these antiemetics should be avoided.</data>
  <data key="d3">chunk-5254cc12db8ae366992b8abc63e9bce0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711464</data>
  <data key="d6"></data>
</node>
<node id="IV Prochlorperazine">
  <data key="d0">IV Prochlorperazine</data>
  <data key="d1">method</data>
  <data key="d2">IV Prochlorperazine is a medication administered intravenously, used in the acute treatment of migraine, often in combination with other drugs.</data>
  <data key="d3">chunk-3968d482efd321ce0e71494d6d8cbde6</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711464</data>
  <data key="d6"></data>
</node>
<node id="IV Diphenhydramine">
  <data key="d0">IV Diphenhydramine</data>
  <data key="d1">method</data>
  <data key="d2">IV Diphenhydramine is an antihistamine administered intravenously, used as adjunct treatment to prevent akathisia and dystonic reactions in migraine patients.</data>
  <data key="d3">chunk-3968d482efd321ce0e71494d6d8cbde6</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711464</data>
  <data key="d6"></data>
</node>
<node id="IV Hydromorphone">
  <data key="d0">IV Hydromorphone</data>
  <data key="d1">method</data>
  <data key="d2">IV Hydromorphone is an opioid administered intravenously, compared against other treatments for migraine relief.</data>
  <data key="d3">chunk-3968d482efd321ce0e71494d6d8cbde6</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711464</data>
  <data key="d6"></data>
</node>
<node id="IV Metoclopramide">
  <data key="d0">IV Metoclopramide</data>
  <data key="d1">method</data>
  <data key="d2">IV Metoclopramide is a medication administered intravenously, demonstrated to be effective for acute migraine treatment in systematic reviews.</data>
  <data key="d3">chunk-3968d482efd321ce0e71494d6d8cbde6</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711464</data>
  <data key="d6"></data>
</node>
<node id="Granisetron">
  <data key="d0">Granisetron</data>
  <data key="d1">method</data>
