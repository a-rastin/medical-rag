  <data key="d12">1792711476</data>
  <data key="d13"></data>
</edge>
<edge source="Triptans" target="Moderate to Severe Migraine Attacks">
  <data key="d7">1.0</data>
  <data key="d8">For moderate to severe migraine attacks, a triptan with or without a nonopioid analgesic is suggested.</data>
  <data key="d9">combination therapy,primary treatment</data>
