</edge>
<edge source="Triptans" target="Nonopioid Analgesics">
  <data key="d7">1.0</data>
  <data key="d8">The combined use of an NSAID with a triptan is more effective than either agent alone.</data>
  <data key="d9">combined therapy effectiveness</data>
  <data key="d10">chunk-eced74bbae68c4d04d0938805d606b4f</data>
