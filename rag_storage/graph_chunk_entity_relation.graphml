  <data key="d13"></data>
</edge>
<edge source="CGRP Antagonists" target="Fremanezumab">
  <data key="d7">1.0</data>
  <data key="d8">Fremanezumab is a CGRP antibody used in the context of CGRP antagonists for headache prevention.</data>
