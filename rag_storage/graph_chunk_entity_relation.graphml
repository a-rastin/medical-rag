  <data key="d6"></data>
</node>
<node id="Transcranial Magnetic Stimulation">
  <data key="d0">Transcranial Magnetic Stimulation</data>
  <data key="d1">method</data>
  <data key="d2">Transcranial Magnetic Stimulation is a method for acute treatment of migraine with aura tested in randomized, double-blind, parallel-group, sham-controlled trials.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Noninvasive Vagus Nerve Stimulation">
  <data key="d0">Noninvasive Vagus Nerve Stimulation</data>
  <data key="d1">method</data>
  <data key="d2">Noninvasive Vagus Nerve Stimulation is a method of acute therapy for migraine tested in the randomized PRESTO study.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Sphenopalatine Ganglion Blockade">
  <data key="d0">Sphenopalatine Ganglion Blockade</data>
  <data key="d1">method</data>
  <data key="d2">Sphenopalatine Ganglion Blockade is a therapeutic method involving intranasal administration for acute treatment of chronic migraine.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Intranasal Lidocaine">
  <data key="d0">Intranasal Lidocaine</data>
  <data key="d1">method</data>
  <data key="d2">Intranasal Lidocaine is a treatment for migraine tested in a randomized, double-blind, controlled trial.&lt;SEP&gt;Intranasal lidocaine is an alternative acute therapy for cluster headache, noted for being easy to administer and generally lacking systemic side effects.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443&lt;SEP&gt;chunk-604091b1b25ec431b6eb74ffe266e830&lt;SEP&gt;chunk-f8aa2f95b44d688508b19c8d0fcbc4f3</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711575</data>
  <data key="d6"></data>
</node>
<node id="Repetitive Transnasal Sphenopalatine Ganglion Blockade">
  <data key="d0">Repetitive Transnasal Sphenopalatine Ganglion Blockade</data>
  <data key="d1">method</data>
  <data key="d2">Repetitive Transnasal Sphenopalatine Ganglion Blockade with tx360(®) is an acute treatment for chronic migraine tested in a double-blind, placebo-controlled study.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="American Academy of Neurology">
  <data key="d0">American Academy of Neurology</data>
  <data key="d1">organization</data>
  <data key="d2">American Academy of Neurology is a professional organization that published top five choosing wisely recommendations.&lt;SEP&gt;The American Academy of Neurology is a professional organization that conducted a meta-analysis on the utilization of CT and MRI in patients presenting with headache.&lt;SEP&gt;The American Academy of Neurology is a professional organization that reported quality standards for neurologic examinations.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443&lt;SEP&gt;chunk-d93c3ae2e3eb96980253ed880c4042a8&lt;SEP&gt;chunk-67064a19688d3727bfd01270acdcdada</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711756</data>
  <data key="d6"></data>
</node>
<node id="Dopamine Antagonists">
  <data key="d0">Dopamine Antagonists</data>
  <data key="d1">data</data>
  <data key="d2">Dopamine Antagonists are a treatment compared against sodium valproate in a systematic review for acute migraine in the emergency department.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Greater Occipital Nerve Blocks">
  <data key="d0">Greater Occipital Nerve Blocks</data>
  <data key="d1">method</data>
  <data key="d2">Greater Occipital Nerve Blocks with Bupivacaine are a randomized, sham-controlled trial for acute migraine patients refractory to standard emergency department treatment with metoclopramide.&lt;SEP&gt;Greater occipital nerve blocks involve anesthetic blockade or glucocorticoid injection for refractory chronic cluster headache.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443&lt;SEP&gt;chunk-ba771d788f7481cea05e87c2e085913d</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711576</data>
  <data key="d6"></data>
</node>
<node id="tx360(®)">
  <data key="d0">tx360(®)</data>
  <data key="d1">artifact</data>
  <data key="d2">tx360(®) is a device used for repetitive transnasal sphenopalatine ganglion blockade as acute treatment for chronic migraine.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Remote Electrical Neuromodulation (REN)">
  <data key="d0">Remote Electrical Neuromodulation (REN)</data>
  <data key="d1">method</data>
  <data key="d2">Remote Electrical Neuromodulation (REN) is a method that relieves acute migraine in randomized, double-blind, placebo-controlled, multicenter trials.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Single-pulse Transcranial Magnetic Stimulation">
  <data key="d0">Single-pulse Transcranial Magnetic Stimulation</data>
  <data key="d1">method</data>
  <data key="d2">Single-pulse Transcranial Magnetic Stimulation is a method for acute treatment of migraine with aura in randomized, double-blind, parallel-group, sham-controlled trials.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Acute Migraine">
  <data key="d0">Acute Migraine</data>
  <data key="d1">concept</data>
  <data key="d2">Acute Migraine refers to the sudden onset of migraine pain, which is the primary target of the treatments evaluated in the studies listed.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Chronic Migraine">
  <data key="d0">Chronic Migraine</data>
  <data key="d1">concept</data>
  <data key="d2">Chronic migraine risk is increased by the use of opioids and butalbital.&lt;SEP&gt;Chronic Migraine is defined by the frequency and duration of headache days, and is the specific indication for some of the treatments like sphenopalatine ganglion blockade.</data>
  <data key="d3">chunk-74803e1d9bd621760a74773f08649443&lt;SEP&gt;chunk-22a7faa6dc2428acdd3ea3c1593916bb</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Greater Occipital Nerve">
  <data key="d0">Greater Occipital Nerve</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Greater occipital nerve is targeted in occipital nerve blocks for migraine treatment.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Local Anesthetic">
  <data key="d0">Local Anesthetic</data>
  <data key="d1">data</data>
  <data key="d2">Local anesthetic is used in nerve blocks, with known allergy being a contraindication.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Bupivacaine">
  <data key="d0">Bupivacaine</data>
  <data key="d1">data</data>
  <data key="d2">Bupivacaine is a local anesthetic used in sphenopalatine ganglion blocks.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Opioids">
  <data key="d0">Opioids</data>
  <data key="d1">concept</data>
  <data key="d2">Opioids are generally not as effective as migraine-specific medications and carry risks of tolerance and dependence.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Barbiturates">
  <data key="d0">Barbiturates</data>
  <data key="d1">concept</data>
  <data key="d2">Barbiturates, such as butalbital-containing compounds, lack high-quality evidence for acute migraine efficacy.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Supraorbital Nerve">
  <data key="d0">Supraorbital Nerve</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Supraorbital nerve is a branch of the trigeminal nerve used in migraine treatment.&lt;SEP&gt;The supraorbital nerve is a target of sensory trigeminal nerve procedures for cluster headache.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb&lt;SEP&gt;chunk-8fcccbfac9c2ef745a159d63b88ddc90</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711572</data>
  <data key="d6"></data>
</node>
<node id="Auriculo-temporal Nerve">
  <data key="d0">Auriculo-temporal Nerve</data>
  <data key="d1">naturalobject</data>
  <data key="d2">Auriculo-temporal nerve is a branch of the trigeminal nerve used in migraine treatment.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711460</data>
  <data key="d6"></data>
</node>
<node id="Occipital Nerve Blocks">
  <data key="d0">Occipital Nerve Blocks</data>
  <data key="d1">method</data>
  <data key="d2">Occipital nerve blocks involve bilateral greater occipital nerve blocks administered in emergency departments.&lt;SEP&gt;Occipital nerve blocks have been shown to be effective analgesia for occipital neuritis and undifferentiated primary headache.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb&lt;SEP&gt;chunk-764b1321ae6bc951a2c8d2de5901567f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711754</data>
  <data key="d6"></data>
</node>
<node id="Sphenopalatine Ganglion Blocks">
  <data key="d0">Sphenopalatine Ganglion Blocks</data>
  <data key="d1">method</data>
  <data key="d2">Sphenopalatine ganglion blocks utilize intranasal devices for topical application of local anesthetic.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Lidocaine">
  <data key="d0">Lidocaine</data>
  <data key="d1">data</data>
  <data key="d2">Lidocaine 4 percent intranasal was used in trials for acute migraine treatment.&lt;SEP&gt;Intranasal lidocaine in a 4 percent topical solution is suggested to be effective in at least one-third of patients, although the degree of benefit is modest.&lt;SEP&gt;Alternative therapy for acute cluster headache who do not respond to or tolerate initial therapy.&lt;SEP&gt;Lidocaine is a substance studied in the context of treating cluster headache attacks.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb&lt;SEP&gt;chunk-0a3bc3f7fc9283c8a89abea7bd6a2953&lt;SEP&gt;chunk-f8aa2f95b44d688508b19c8d0fcbc4f3&lt;SEP&gt;chunk-697366b5ec6fccd401f60e32f476bcb8</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711570</data>
  <data key="d6"></data>
</node>
<node id="Patient Education Materials">
  <data key="d0">Patient Education Materials</data>
  <data key="d1">content</data>
  <data key="d2">Patient education materials include "The Basics" and "Beyond the Basics" for migraine and headache conditions.</data>
  <data key="d3">chunk-22a7faa6dc2428acdd3ea3c1593916bb</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Calcitonin Gene-Related Peptide (CGRP)">
  <data key="d0">Calcitonin Gene-Related Peptide (CGRP)</data>
  <data key="d1">data</data>
  <data key="d2">Calcitonin gene-related peptide (CGRP) is a peptide whose levels are reduced by triptans, mediating their effect on migraine pain.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0&lt;SEP&gt;chunk-9781a20ce9291545e13c64cc40854f23</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Brainstem">
  <data key="d0">Brainstem</data>
  <data key="d1">location</data>
  <data key="d2">The brainstem is the region where triptans block pain pathways.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Trigeminal Nucleus Caudalis">
  <data key="d0">Trigeminal Nucleus Caudalis</data>
  <data key="d1">location</data>
  <data key="d2">The trigeminal nucleus caudalis is a target site where triptans inhibit transmission to block afferent input.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Descending Brainstem Pain-Modulating Pathways">
  <data key="d0">Descending Brainstem Pain-Modulating Pathways</data>
  <data key="d1">method</data>
  <data key="d2">Descending brainstem pain-modulating pathways are activated by triptans to inhibit dural nociception.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="5-HT 1b/1d Receptors">
  <data key="d0">5-HT 1b/1d Receptors</data>
  <data key="d1">concept</data>
  <data key="d2">5-HT 1b/1d receptors are receptor types activated by triptans in pain-modulating pathways.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Dural Nociception">
  <data key="d0">Dural Nociception</data>
  <data key="d1">condition</data>
  <data key="d2">Dural nociception refers to pain signaling from the dura mater, which is inhibited by triptans.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Network Meta-Analysis">
  <data key="d0">Network Meta-Analysis</data>
  <data key="d1">method</data>
  <data key="d2">A network meta-analysis of 137 randomized acute treatment trials involving nearly 90,000 individuals supported triptans as first-line agents.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Randomized Controlled Trials">
  <data key="d0">Randomized Controlled Trials</data>
  <data key="d1">method</data>
  <data key="d2">Randomized controlled trials and systematic reviews have found individual triptans effective for acute migraine treatment.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Pain Relief">
  <data key="d0">Pain Relief</data>
  <data key="d1">concept</data>
  <data key="d2">Pain relief is a main outcome measure in migraine trials, with eletriptan showing significant benefit over placebo.&lt;SEP&gt;Pain relief was reported at 15 minutes in a majority of patients, with 67 percent achieving relief versus 7 percent in control.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0&lt;SEP&gt;chunk-8fcccbfac9c2ef745a159d63b88ddc90</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF&lt;SEP&gt;iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711572</data>
  <data key="d6"></data>
</node>
<node id="Headache Response">
  <data key="d0">Headache Response</data>
  <data key="d1">category</data>
  <data key="d2">Headache response at one and two hours is a main outcome measure in eletriptan trials.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Sustained Relief">
  <data key="d0">Sustained Relief</data>
  <data key="d1">category</data>
  <data key="d2">Sustained relief over 24 hours is a main outcome measure in eletriptan trials.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Adverse Events">
  <data key="d0">Adverse Events</data>
  <data key="d1">category</data>
  <data key="d2">Adverse events associated with triptans are generally transient and reversible, with minor side effects being dose-related.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Subcutaneous Injection">
  <data key="d0">Subcutaneous Injection</data>
  <data key="d1">method</data>
  <data key="d2">Subcutaneous injection is a route of administration for sumatriptan, usually via autoinjector in the thigh.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Nasal Spray">
  <data key="d0">Nasal Spray</data>
  <data key="d1">method</data>
  <data key="d2">Nasal spray is a route of administration for sumatriptan and zolmitriptan.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Nasal Powder">
  <data key="d0">Nasal Powder</data>
  <data key="d1">method</data>
  <data key="d2">Nasal powder is a route of administration for sumatriptan.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Orally Disintegrating Tablets">
  <data key="d0">Orally Disintegrating Tablets</data>
  <data key="d1">method</data>
  <data key="d2">Orally disintegrating tablets and/or films are formulations for naratriptan and rizatriptan.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Complete Pain Relief">
  <data key="d0">Complete Pain Relief</data>
  <data key="d1">category</data>
  <data key="d2">Complete pain relief at two hours is a primary efficacy outcome, with eletriptan showing higher rates than comparators.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Pain Relief at Four Hours">
  <data key="d0">Pain Relief at Four Hours</data>
  <data key="d1">category</data>
  <data key="d2">Pain relief at four hours is a primary outcome for naratriptan, with 2.5 mg being most effective.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Odds Ratio">
  <data key="d0">Odds Ratio</data>
  <data key="d1">data</data>
  <data key="d2">Odds ratio is a statistical measure of treatment effect, such as the 2.15 odds ratio for eletriptan versus naproxen.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="95% Confidence Interval">
  <data key="d0">95% Confidence Interval</data>
  <data key="d1">data</data>
  <data key="d2">95% confidence interval provides the range for the odds ratio, such as 1.5-3.1 for eletriptan versus naproxen.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="United States">
  <data key="d0">United States</data>
  <data key="d1">location</data>
  <data key="d2">Eletriptan 80 mg tablets are not available in the United States; 40 mg is recommended for most patients.</data>
  <data key="d3">chunk-a4041840a72080e115133366da601ba0</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Nausea/Vomiting">
  <data key="d0">Nausea/Vomiting</data>
  <data key="d1">symptom</data>
  <data key="d2">Nausea and vomiting are common symptoms associated with migraine attacks.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Site of Care">
  <data key="d0">Site of Care</data>
  <data key="d1">concept</data>
  <data key="d2">Site of care refers to the location where migraine treatment is administered, such as an emergency department or home setting.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Patient-Specific Factors">
  <data key="d0">Patient-Specific Factors</data>
  <data key="d1">concept</data>
  <data key="d2">Patient-specific factors include cardiovascular risk factors and medication preference, influencing treatment decisions.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Abortive Treatments">
  <data key="d0">Abortive Treatments</data>
  <data key="d1">method</data>
  <data key="d2">Abortive treatments are interventions used to stop or reduce the severity of a migraine attack when given early.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Nonopioid Analgesics">
  <data key="d0">Nonopioid Analgesics</data>
  <data key="d1">method</data>
  <data key="d2">Nonopioid analgesics, such as NSAIDs (ibuprofen, naproxen sodium) and acetaminophen, are used for mild migraine attacks without vomiting or severe nausea.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Status Migrainosus">
  <data key="d0">Status Migrainosus</data>
  <data key="d1">concept</data>
  <data key="d2">Status migrainosus is defined as a debilitating migraine attack lasting for more than 72 hours.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Intravenous Fluids">
  <data key="d0">Intravenous Fluids</data>
  <data key="d1">data</data>
  <data key="d2">Intravenous fluids are suggested as part of the combination treatment for status migrainosus to address dehydration and support medication delivery.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711461</data>
  <data key="d6"></data>
</node>
<node id="Dopamine Receptor Blocker">
  <data key="d0">Dopamine Receptor Blocker</data>
  <data key="d1">method</data>
  <data key="d2">Dopamine receptor blockers, such as prochlorperazine, metoclopramide, and chlorpromazine, are used to manage symptoms in status migrainosus.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711462</data>
  <data key="d6"></data>
</node>
<node id="Ibuprofen">
  <data key="d0">Ibuprofen</data>
  <data key="d1">medication</data>
  <data key="d2">Ibuprofen is a medication evaluated for acute migraine headaches in adults, frequently studied with or without an antiemetic in Cochrane systematic reviews.&lt;SEP&gt;Ibuprofen is a nonsteroidal anti-inflammatory drug (NSAID) suggested for mild migraine attacks.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f&lt;SEP&gt;chunk-e4bdd16b737b7973c6581c7cc92604b7&lt;SEP&gt;chunk-288c1ac0daa4f8d9e6711072456bf290</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711462</data>
  <data key="d6"></data>
</node>
<node id="Naproxen Sodium">
  <data key="d0">Naproxen Sodium</data>
  <data key="d1">medication</data>
  <data key="d2">Naproxen sodium is a nonsteroidal anti-inflammatory drug (NSAID) suggested for mild migraine attacks.</data>
  <data key="d3">chunk-eced74bbae68c4d04d0938805d606b4f</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d5">1792711462</data>
  <data key="d6"></data>
</node>
