</edge>
<edge source="Triptans" target="Subcutaneous Sumatriptan">
  <data key="d7">1.0</data>
  <data key="d8">Subcutaneous sumatriptan is a method of administering triptans via injection for more effective treatment.</data>
  <data key="d9">administration method,efficacy</data>
