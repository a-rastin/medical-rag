<edge source="CGRP Antagonists" target="Rimegepant for Migraine Prevention">
  <data key="d7">1.0</data>
  <data key="d8">Rimegepant is approved for migraine prevention when given at a dose of 75 mg once every other day.</data>
  <data key="d9">migraine prevention,therapeutic class</data>
