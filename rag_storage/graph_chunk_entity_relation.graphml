  <data key="d0">Kostic MA</data>
  <data key="d3">chunk-67064a19688d3727bfd01270acdcdada</data>
  <data key="d2">Kostic MA and Edlow JA co-authored a trial of intravenous prochlorperazine versus subcutaneous sumatriptan in acute migraine therapy.&gt;</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711771</data>
  <data key="d6"></data>
</node>
<node id="Concurrent Rash Indicators">
  <data key="d0">Concurrent Rash Indicators</data>
  <data key="d3">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d2">Concurrent petechial (picture 2) or purpuric (picture 3) rash suggests bacterial meningitis.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711772</data>
  <data key="d6"></data>
</node>
