<edge source="Dexamethasone" target="Early Headache Recurrence">
  <data key="d7">1.0</data>
  <data key="d8">Adjunctive intravenous dexamethasone was found to reduce the rate of early headache recurrence when added to standard acute migraine therapy.</data>
