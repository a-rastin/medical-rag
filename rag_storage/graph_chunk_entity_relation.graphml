  <data key="d13"></data>
</edge>
<edge source="Antiemetics" target="Triptans">
  <data key="d7">1.0</data>
  <data key="d8">An antiemetic drug can be used for moderate to severe attacks complicated by vomiting or severe nausea.</data>
  <data key="d9">concomitant use,nausea management</data>
  <data key="d10">chunk-2878ee960479fec5e0fd7c97d6d44f85</data>
  <data key="d11">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d12">1792711468</data>
  <data key="d13"></data>
</edge>
<edge source="Antiemetics" target="Abortive Treatments">
  <data key="d7">1.0</data>
  <data key="d8">Antiemetics are added when attacks are associated with severe nausea or vomiting.</data>
  <data key="d9">severe nausea,symptom management</data>
  <data key="d10">chunk-eced74bbae68c4d04d0938805d606b4f</data>
