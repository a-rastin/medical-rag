<edge source="Lasmiditan" target="Migraine">
  <data key="d7">2.0</data>
  <data key="d8">Lasmiditan is effective for acute migraine treatment and lacks vasoconstrictor activity.&lt;SEP&gt;Lasmiditan is evaluated for the acute treatment of migraine in clinical trials.</data>
