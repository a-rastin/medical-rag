  <data key="d2">Eekers PJ and Koehler PJ published studies on naratriptan prophylactic treatment in cluster headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711583</data>
  <data key="d6"></data>
</node>
