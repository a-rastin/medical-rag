<edge source="Dihydroergotamine" target="Ischemic vascular disease">
  <data key="d7">1.0</data>
  <data key="d8">Dihydroergotamine is contraindicated in patients with ischemic vascular disease involving cardiac, cerebrovascular, or peripheral circulations.</data>
  <data key="d9">contraindication,vascular safety</data>
  <data key="d10">chunk-cfaea66e0e1b59fcf11083fdc86fa505</data>
