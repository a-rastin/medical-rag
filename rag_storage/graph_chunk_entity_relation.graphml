</edge>
<edge source="Emergency settings" target="Sumatriptan 6 mg subcutaneous injection">
  <data key="d7">1.0</data>
  <data key="d8">Sumatriptan 6 mg subcutaneous injection is a recommended treatment option for severe migraine attacks in emergency settings.</data>
  <data key="d9">recommended treatment,severe migraine</data>
