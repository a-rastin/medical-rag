</edge>
<edge source="Mild Migraine Attacks" target="Simple Analgesics">
  <data key="d7">1.0</data>
  <data key="d8">For mild migraine attacks not associated with vomiting or severe nausea, simple analgesics are often tried first.</data>
  <data key="d9">first-line treatment,mild attacks</data>
  <data key="d10">chunk-2878ee960479fec5e0fd7c97d6d44f85</data>
  <data key="d11">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
  <data key="d12">1792711468</data>
