  <data key="d7">1.0</data>
  <data key="d8">Explosive onset and severe at onset associated with meningismus as a clinical finding.</data>
  <data key="d9">clinical finding,neurological sign</data>
  <data key="d10">chunk-c843eee421b0ff9ddca5fec1a5a3934d</data>
