  <data key="d0">Kirkland SW</data>
  <data key="d1">person</data>
  <data key="d2">Kirkland SW is a researcher who conducted a systematic review and network analysis on parenteral agents for migraine.</data>
  <data key="d3">chunk-9666bb1f91905773a4411559f12b0410</data>
  <data key="d4">iMD - Uptodate - Acute treatment of migraine in adults(1).PDF</data>
