</edge>
<edge source="Magnetic Resonance Angiography" target="Arteriovenous Malformation">
  <data key="d7">1.0</data>
  <data key="d8">MRA is used to identify arteriovenous malformation as the underlying cause of subarachnoid hemorrhage.</data>
  <data key="d9">underlying cause identification,vascular imaging</data>
  <data key="d10">chunk-d93c3ae2e3eb96980253ed880c4042a8</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711768</data>
  <data key="d13"></data>
</edge>
<edge source="Catheter Angiography" target="Cerebral Aneurysm">
  <data key="d7">1.0</data>
  <data key="d8">Catheter angiography is used for definitive vascular imaging to confirm cerebral aneurysm when non-invasive methods are inconclusive.</data>
  <data key="d9">cause confirmation,definitive vascular imaging</data>
  <data key="d10">chunk-d93c3ae2e3eb96980253ed880c4042a8</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711768</data>
  <data key="d13"></data>
</edge>
<edge source="Neurology Consultation" target="High-Risk Headache Features">
  <data key="d7">1.0</data>
  <data key="d8">Neurology consultation may facilitate both the acute evaluation and follow-up for patients with high-risk headache features and nondiagnostic testing.</data>
  <data key="d9">diagnostic facilitation,specialist evaluation</data>
  <data key="d10">chunk-d93c3ae2e3eb96980253ed880c4042a8</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711769</data>
  <data key="d13"></data>
</edge>
<edge source="Hasbun R" target="Quagliarello VJ">
  <data key="d7">1.0</data>
  <data key="d8">Hasbun R and Quagliarello VJ co-authored a study on head computed tomography before lumbar puncture in adults with suspected meningitis.&gt;</data>
  <data key="d9">collaboration,study authorship</data>
  <data key="d10">chunk-67064a19688d3727bfd01270acdcdada</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711769</data>
  <data key="d13"></data>
</edge>
<edge source="Meningeal Irritation" target="Benign Process">
  <data key="d7">1.0</data>
  <data key="d8">Head pain that spreads into the lower neck (ie, occipitonuchal headache) and between the shoulders may indicate meningeal irritation due to either infection or subarachnoid blood; it is not typical of a benign process.</data>
  <data key="d9">diagnosis,symptoms</data>
  <data key="d10">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711770</data>
  <data key="d13"></data>
</edge>
<edge source="Anticoagulants" target="Intracranial Bleeding">
  <data key="d7">1.0</data>
  <data key="d8">All anticoagulants confer an increased bleeding risk, including bleeding into the brain.</data>
  <data key="d9">bleeding risk,medication side effect</data>
  <data key="d10">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711770</data>
  <data key="d13"></data>
</edge>
<edge source="Sympathomimetics" target="Intracranial Bleeding">
  <data key="d7">1.0</data>
  <data key="d8">Sympathomimetics are also associated with intracranial bleeding.</data>
  <data key="d9">bleeding risk,medication side effect</data>
  <data key="d10">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711771</data>
  <data key="d13"></data>
</edge>
<edge source="Intracranial Bleeding" target="Illicit Drugs">
  <data key="d7">1.0</data>
  <data key="d8">A number of illicit drugs, including cocaine, methamphetamine, and other sympathomimetic agents, increase the risk of stroke and intracranial bleeding.</data>
  <data key="d9">neurological risk,substance abuse</data>
  <data key="d10">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711771</data>
  <data key="d13"></data>
</edge>
<edge source="Illicit Drugs" target="Stroke Risk">
  <data key="d7">1.0</data>
  <data key="d8">A number of illicit drugs, including cocaine, methamphetamine, and other sympathomimetic agents, increase the risk of stroke and intracranial bleeding.</data>
  <data key="d9">neurological risk,substance abuse</data>
