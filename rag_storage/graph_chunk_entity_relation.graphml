</edge>
<edge source="Triptans" target="Cardiovascular Risk">
  <data key="d7">1.0</data>
  <data key="d8">Triptans should be avoided in patients with ischemic stroke, ischemic heart disease, Prinzmetal's angina, and uncontrolled hypertension.</data>
  <data key="d9">contraindications,safety profile</data>
  <data key="d10">chunk-b20a73b1bf34e686ee6652ff377b531a</data>
