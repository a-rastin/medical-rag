</node>
<node id="Warfarin">
  <data key="d0">Warfarin</data>
  <data key="d1">data</data>
  <data key="d2">Patients on warfarin have a higher risk of intracranial hemorrhage compared with those on direct oral anticoagulants (DOACs).</data>
  <data key="d3">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d4">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
