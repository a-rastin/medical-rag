<edge source="Triptans" target="Medication Overuse Headache">
  <data key="d7">1.0</data>
  <data key="d8">All triptans should be limited to no more than 10 days of use per month to avoid medication overuse headache.</data>
  <data key="d9">risk management,usage limits</data>
  <data key="d10">chunk-b20a73b1bf34e686ee6652ff377b531a</data>
