</edge>
<edge source="Noninvasive Neuromodulation Devices" target="Drug Treatments">
  <data key="d7">1.0</data>
  <data key="d8">Noninvasive neuromodulation devices are typically used for patients who do not respond to or tolerate drug treatments.</data>
