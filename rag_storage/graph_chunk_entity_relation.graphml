  <data key="d13"></data>
</edge>
<edge source="New Onset Nontraumatic Headache" target="Primary Headache Syndromes">
  <data key="d7">1.0</data>
  <data key="d8">The evaluation of new-onset nontraumatic headache involves identifying primary headache syndromes.</data>
  <data key="d9">assessment focus,clinical evaluation</data>
  <data key="d10">chunk-469ba9f85eff0d1ef2fc5b0807c28e01</data>
  <data key="d11">iMD_Uptodate_Emergency_evaluation_of_the_adult_with_new_nontraumatic.PDF</data>
