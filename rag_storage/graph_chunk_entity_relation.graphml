  <data key="d0">Viral Encephalitis</data>
  <data key="d1">concept</data>
  <data key="d2">Viral encephalitis is a central nervous system infection.</data>
  <data key="d3">chunk-7d7e2a1fa6fae352f798fe0d6e8e0e62</data>
