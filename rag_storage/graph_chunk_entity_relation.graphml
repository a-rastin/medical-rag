  <data key="d13"></data>
</edge>
<edge source="Malignancy" target="Intracranial Metastasis">
  <data key="d7">1.0</data>
  <data key="d8">Malignancy with a risk of intracranial metastasis (and possibly increased intracranial pressure [ICP]).</data>
  <data key="d9">complication,increased ICP</data>
  <data key="d10">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711771</data>
  <data key="d13"></data>
</edge>
<edge source="Polycystic Kidney Disease" target="Aneurysm Risk">
  <data key="d7">1.0</data>
  <data key="d8">Polycystic kidney disease or connective tissue disease, both of which increase the risk of aneurysms with resultant SAH.</data>
  <data key="d9">genetic condition,vascular risk</data>
  <data key="d10">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711771</data>
  <data key="d13"></data>
</edge>
<edge source="Connective Tissue Disease" target="Aneurysm Risk">
  <data key="d7">1.0</data>
  <data key="d8">Polycystic kidney disease or connective tissue disease, both of which increase the risk of aneurysms with resultant SAH.</data>
  <data key="d9">genetic condition,vascular risk</data>
  <data key="d10">chunk-ccbcc20d04c05bb1a254eb147d0d3a3f</data>
