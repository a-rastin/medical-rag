  <data key="d3">chunk-e949ceaa91563d5020dfddbce0137142</data>
  <data key="d2">Siow HC and Pozo-Rosich P published studies on frovatriptan for the treatment of cluster headaches.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711583</data>
  <data key="d6"></data>
</node>
<node id="Krabbe A">
  <data key="d0">Krabbe A</data>
  <data key="d3">chunk-e949ceaa91563d5020dfddbce0137142</data>
  <data key="d2">Monstad I and Krabbe A published studies on preemptive oral treatment with sumatriptan during a cluster period.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711583</data>
  <data key="d6"></data>
</node>
<node id="Magnoux E">
  <data key="d0">Magnoux E</data>
  <data key="d3">chunk-e949ceaa91563d5020dfddbce0137142</data>
  <data key="d2">Pringsheim T and Magnoux E published a pilot study on melatonin as adjunctive therapy in the prophylaxis of cluster headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711583</data>
  <data key="d6"></data>
</node>
<node id="Shah ND">
  <data key="d0">Shah ND</data>
  <data key="d3">chunk-e949ceaa91563d5020dfddbce0137142</data>
  <data key="d2">Prakash S and Shah ND published case reports and a critical review of cluster headache literature responsive to indomethacin.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711583</data>
  <data key="d6"></data>
</node>
<node id="Paemeleire K">
  <data key="d0">Paemeleire K</data>
  <data key="d3">chunk-7cddaa60186a583b48d21588a10557f5</data>
  <data key="d2">Paemeleire K and Bahra A are co-authors of academic literature on medication-overuse headache in patients with cluster headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711584</data>
  <data key="d6"></data>
</node>
<node id="Kotchetkov IS">
  <data key="d0">Kotchetkov IS</data>
  <data key="d3">chunk-e949ceaa91563d5020dfddbce0137142</data>
  <data key="d2">Freund B and Kotchetkov IS published a systematic review on the efficacy of botulinum toxin in cluster headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711584</data>
  <data key="d6"></data>
</node>
<node id="Jamtøy KA">
  <data key="d0">Jamtøy KA</data>
  <data key="d3">chunk-e949ceaa91563d5020dfddbce0137142</data>
  <data key="d2">Simmonds L and Jamtøy KA published an open label experience of repeated OnabotulinumtoxinA injections towards the sphenopalatine ganglion in patients with chronic cluster headache and chronic migraine.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711584</data>
  <data key="d6"></data>
</node>
<node id="Lind F">
  <data key="d0">Lind F</data>
  <data key="d3">chunk-e949ceaa91563d5020dfddbce0137142</data>
  <data key="d2">Nilsson Remahl AI and Lind F published a double-blind placebo-controlled cross-over study on hyperbaric oxygen treatment of active cluster headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711584</data>
  <data key="d6"></data>
</node>
<node id="Diener HC">
  <data key="d0">Diener HC</data>
  <data key="d3">chunk-e949ceaa91563d5020dfddbce0137142</data>
  <data key="d2">Gaul C and Diener HC published a randomised controlled study on non-invasive vagus nerve stimulation for PREVention and Acute treatment of chronic cluster headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711584</data>
  <data key="d6"></data>
</node>
<node id="de Coo IF">
  <data key="d0">de Coo IF</data>
  <data key="d3">chunk-e949ceaa91563d5020dfddbce0137142</data>
  <data key="d2">Goadsby PJ and de Coo IF published a randomized, double-blind, sham-controlled study on non-invasive vagus nerve stimulation for the acute treatment of episodic and chronic cluster headache.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711584</data>
  <data key="d6"></data>
</node>
<node id="Trigemium Autonomic Cephalalgias">
  <data key="d0">Trigemium Autonomic Cephalalgias</data>
  <data key="d3">chunk-604091b1b25ec431b6eb74ffe266e830</data>
  <data key="d2">Paroxysmal hemicrania is a type of trigeminal autonomic cephalalgia.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711585</data>
  <data key="d6"></data>
</node>
<node id="Vascular Headaches">
  <data key="d0">Vascular Headaches</data>
  <data key="d3">chunk-feb1965a69687b7da4c479723318f38b</data>
  <data key="d2">Pizotifen was reviewed for its pharmacological properties and therapeutic efficacy in vascular headaches.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711585</data>
  <data key="d6"></data>
</node>
<node id="First-line preventive medications">
  <data key="d0">First-line preventive medications</data>
  <data key="d3">chunk-697366b5ec6fccd401f60e32f476bcb8</data>
  <data key="d2">Galcanezumab is reserved for patients with prior cluster headache periods lasting longer than one month when first-line preventive medications are ineffective, poorly tolerated, or contraindicated.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711586</data>
  <data key="d6"></data>
</node>
<node id="Initial preventive therapies">
  <data key="d0">Initial preventive therapies</data>
  <data key="d3">chunk-697366b5ec6fccd401f60e32f476bcb8</data>
  <data key="d2">Lithium is an alternative medication for some patients who do not respond to initial preventive therapies.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711586</data>
  <data key="d6"></data>
</node>
<node id="ECG monitoring">
  <data key="d0">ECG monitoring</data>
  <data key="d3">chunk-2f74beccf3932fc999c5da6217dd983e</data>
  <data key="d2">An ECG should be obtained after each dose increment above a total daily dose of 480 mg to assess for cardiac conduction delays; some experts recommend getting a pretreatment ECG to screen for baseline cardiac arrhythmia.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d5">1792711587</data>
  <data key="d6"></data>
</node>
<node id="Subarachnoid hemorrhage">
  <data key="d0">Subarachnoid hemorrhage</data>
  <data key="d1">concept</data>
  <data key="d2">Subarachnoid hemorrhage is a type of bleeding into the subarachnoid space, often presenting with sudden severe headache and neck pain.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Reversible cerebral vasoconstriction syndromes">
  <data key="d0">Reversible cerebral vasoconstriction syndromes</data>
  <data key="d1">concept</data>
  <data key="d2">Reversible cerebral vasoconstriction syndromes (RCVS) are characterized by thunderclap headaches that recur over days to weeks, often triggered by exertion or stress.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Cervical artery dissection">
  <data key="d0">Cervical artery dissection</data>
  <data key="d1">concept</data>
  <data key="d2">Cervical artery dissection involves a tear in the artery wall of the neck, often following trauma, and can present with neck pain and neurological symptoms.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Cerebral vein and dural sinus thrombosis">
  <data key="d0">Cerebral vein and dural sinus thrombosis</data>
  <data key="d1">concept</data>
  <data key="d2">Cerebral vein and dural sinus thrombosis involves clotting in the brain's venous sinuses, presenting with headache, seizures, and neurological deficits.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Hypertensive encephalopathy/reversible posterior leukoencephalopathy syndrome">
  <data key="d0">Hypertensive encephalopathy/reversible posterior leukoencephalopathy syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Hypertensive encephalopathy presents with severe hypertension, seizures, and visual symptoms, often with headaches of insidious onset.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Meningitis/encephalitis">
  <data key="d0">Meningitis/encephalitis</data>
  <data key="d1">concept</data>
  <data key="d2">Meningitis/encephalitis involves inflammation of the brain membranes, often presenting with fever, neck stiffness, and altered mental status.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Brain abscess">
  <data key="d0">Brain abscess</data>
  <data key="d1">concept</data>
  <data key="d2">Brain abscess is a localized infection in the brain tissue, often following bacteremia or infection, presenting with fever and neurological deficits.&lt;SEP&gt;Brain abscess is a serious cause of headache associated with focal neurologic findings.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9&lt;SEP&gt;chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF&lt;SEP&gt;iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711756</data>
  <data key="d6"></data>
</node>
<node id="Brain tumor">
  <data key="d0">Brain tumor</data>
  <data key="d1">concept</data>
  <data key="d2">Brain tumor presents with headache, often exacerbated by Valsalva maneuvers, and can cause seizures and neurological deficits.&lt;SEP&gt;Brain tumor is a high-risk cause of headache that worsens with cough or Valsalva due to elevated ICP.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9&lt;SEP&gt;chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF&lt;SEP&gt;iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711756</data>
  <data key="d6"></data>
</node>
<node id="Intracranial, extra-axial hematoma">
  <data key="d0">Intracranial, extra-axial hematoma</data>
  <data key="d1">concept</data>
  <data key="d2">Intracranial hematomas (subdural or epidural) typically follow head trauma and can cause progressive decline in mental status.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Intraparenchymal hemorrhage">
  <data key="d0">Intraparenchymal hemorrhage</data>
  <data key="d1">concept</data>
  <data key="d2">Intraparenchymal hemorrhage involves bleeding within the brain parenchyma, often sudden in onset, with neurological findings dependent on the site.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Colloid cyst of third ventricle">
  <data key="d0">Colloid cyst of third ventricle</data>
  <data key="d1">concept</data>
  <data key="d2">Colloid cyst of the third ventricle can cause positional headaches and altered mental status.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Idiopathic intracranial hypertension">
  <data key="d0">Idiopathic intracranial hypertension</data>
  <data key="d1">concept</data>
  <data key="d2">Idiopathic intracranial hypertension typically affects overweight females and presents with papilledema and visual disturbances.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Spontaneous intracranial hypotension">
  <data key="d0">Spontaneous intracranial hypotension</data>
  <data key="d1">concept</data>
  <data key="d2">Spontaneous intracranial hypotension presents with severe headache upon standing, often relieved by lying flat.&lt;SEP&gt;Spontaneous intracranial hypotension is characterized by headaches that worsen upon standing due to CSF leaks.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9&lt;SEP&gt;chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF&lt;SEP&gt;iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711756</data>
  <data key="d6"></data>
</node>
<node id="Acute narrow-angle glaucoma">
  <data key="d0">Acute narrow-angle glaucoma</data>
  <data key="d1">concept</data>
  <data key="d2">Acute narrow-angle glaucoma is an ocular emergency presenting with eye pain, vision changes, and elevated intraocular pressure.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Giant cell arteritis">
  <data key="d0">Giant cell arteritis</data>
  <data key="d1">concept</data>
  <data key="d2">Giant cell arteritis affects individuals over 50, presenting with headache, visual disturbances, and tender temporal arteries.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Carbon monoxide toxicity">
  <data key="d0">Carbon monoxide toxicity</data>
  <data key="d1">concept</data>
  <data key="d2">Carbon monoxide toxicity results from CO exposure, causing headache that improves when away from the source, with severe cases leading to coma or seizures.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Thunderclap onset">
  <data key="d0">Thunderclap onset</data>
  <data key="d1">concept</data>
  <data key="d2">Thunderclap onset refers to a headache that reaches maximum intensity within seconds to minutes, a key feature of subarachnoid hemorrhage.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Severe neck pain">
  <data key="d0">Severe neck pain</data>
  <data key="d1">concept</data>
  <data key="d2">Severe neck pain is a common accompanying symptom in conditions like subarachnoid hemorrhage and meningitis.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Diplopia">
  <data key="d0">Diplopia</data>
  <data key="d1">concept</data>
  <data key="d2">Diplopia, or double vision, can be a neurological sign associated with various intracranial pathologies.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711626</data>
  <data key="d6"></data>
</node>
<node id="Meningismus">
  <data key="d0">Meningismus</data>
  <data key="d1">concept</data>
  <data key="d2">Meningismus refers to meningeal irritation signs, such as neck stiffness, often seen in meningitis or subarachnoid hemorrhage.&lt;SEP&gt;Meningismus is a clinical feature associated with headache linked to serious pathology.&lt;SEP&gt;Meningismus may indicate meningitis or SAH and can be subtle, with lower sensitivity and specificity in adults older than 60 years.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9&lt;SEP&gt;chunk-c843eee421b0ff9ddca5fec1a5a3934d&lt;SEP&gt;chunk-62e03c9a26baa74eae064a1bded7c588&lt;SEP&gt;chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF&lt;SEP&gt;iMD_Uptodate_Clinical_features_of_headache_associated_with_serious.PDF&lt;SEP&gt;iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711752</data>
  <data key="d6"></data>
</node>
<node id="Nausea and vomiting">
  <data key="d0">Nausea and vomiting</data>
  <data key="d1">finding</data>
  <data key="d2">Nausea and vomiting are common non-specific symptoms associated with severe neurological events.&lt;SEP&gt;Nausea and vomiting can accompany increased ICP, intracranial hemorrhage, or acute angle-closure glaucoma but are also common with migraine.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9&lt;SEP&gt;chunk-62e03c9a26baa74eae064a1bded7c588</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF&lt;SEP&gt;iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711752</data>
  <data key="d6"></data>
</node>
<node id="Neurologic deficits from underlying stroke or edema">
  <data key="d0">Neurologic deficits from underlying stroke or edema</data>
  <data key="d1">concept</data>
  <data key="d2">Neurologic deficits may develop in RCVS due to underlying stroke or cerebral edema.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Nystagmus">
  <data key="d0">Nystagmus</data>
  <data key="d1">concept</data>
  <data key="d2">Nystagmus, involuntary eye movement, can be a sign of cervical artery dissection or brainstem involvement.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Horner syndrome">
  <data key="d0">Horner syndrome</data>
  <data key="d1">concept</data>
  <data key="d2">Horner syndrome, characterized by ptosis and miosis, can indicate cervical artery dissection.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Cranial neuropathy">
  <data key="d0">Cranial neuropathy</data>
  <data key="d1">concept</data>
  <data key="d2">Cranial neuropathy can present with various neurological deficits depending on the affected nerve.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Papilledema">
  <data key="d0">Papilledema</data>
  <data key="d1">finding</data>
  <data key="d2">Papilledema, optic disc swelling, is a sign of increased intracranial pressure seen in many conditions.&lt;SEP&gt;Papilledema, detected by blurring of the optic disks, is indicative of increased ICP, possibly due to a tumor or other structural abnormality.&lt;SEP&gt;Papilledema is a clinical finding associated with CT abnormalities contraindicating lumbar puncture.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9&lt;SEP&gt;chunk-62e03c9a26baa74eae064a1bded7c588&lt;SEP&gt;chunk-d3b99ec17053435d72311359e33c6696&lt;SEP&gt;chunk-62c387dc1abd6c2085428bd5bab9c2b4</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF&lt;SEP&gt;iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d5">1792711752</data>
  <data key="d6"></data>
</node>
<node id="Retinal hemorrhage">
  <data key="d0">Retinal hemorrhage</data>
  <data key="d1">concept</data>
  <data key="d2">Retinal hemorrhage can occur in hypertensive encephalopathy.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Encephalopathy">
  <data key="d0">Encephalopathy</data>
  <data key="d1">concept</data>
  <data key="d2">Encephalopathy refers to diffuse brain dysfunction, often presenting with altered mental status.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Hematuria and proteinuria">
  <data key="d0">Hematuria and proteinuria</data>
  <data key="d1">concept</data>
  <data key="d2">Hematuria and proteinuria may be associated with hypertensive encephalopathy.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Fever (often &gt;38°C)">
  <data key="d0">Fever (often &gt;38°C)</data>
  <data key="d1">concept</data>
  <data key="d2">High fever is a common feature of meningitis/encephalitis.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Neck pain or stiffness">
  <data key="d0">Neck pain or stiffness</data>
  <data key="d1">concept</data>
  <data key="d2">Neck pain or stiffness is a hallmark sign of meningeal irritation.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Confusion or lethargy">
  <data key="d0">Confusion or lethargy</data>
  <data key="d1">concept</data>
  <data key="d2">Confusion or lethargy can be present in meningitis, encephalitis, and brain abscess.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Altered mental status">
  <data key="d0">Altered mental status</data>
  <data key="d1">concept</data>
  <data key="d2">Altered mental status is a common feature in brain abscess, tumor, and intracranial hemorrhage.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9&lt;SEP&gt;chunk-44f11db3bcd7ce2dafa15cd85b96c021</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Visual deficits">
  <data key="d0">Visual deficits</data>
  <data key="d1">concept</data>
  <data key="d2">Visual deficits can include field cuts or transient changes, seen in idiopathic intracranial hypertension.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Sixth cranial nerve palsy">
  <data key="d0">Sixth cranial nerve palsy</data>
  <data key="d1">concept</data>
  <data key="d2">Sixth cranial nerve palsy causes double vision and is associated with idiopathic intracranial hypertension.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Tinnitus">
  <data key="d0">Tinnitus</data>
  <data key="d1">concept</data>
  <data key="d2">Tinnitus, or ringing in the ears, can be associated with idiopathic intracranial hypotension.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Eye pain">
  <data key="d0">Eye pain</data>
  <data key="d1">concept</data>
  <data key="d2">Eye pain is a primary symptom of acute narrow-angle glaucoma.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Red or tearing eye">
  <data key="d0">Red or tearing eye</data>
  <data key="d1">concept</data>
  <data key="d2">Redness and tearing are common ocular signs in acute narrow-angle glaucoma.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Decreased vision">
  <data key="d0">Decreased vision</data>
  <data key="d1">concept</data>
  <data key="d2">Decreased vision is a symptom of acute narrow-angle glaucoma.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Red, injected conjunctiva">
  <data key="d0">Red, injected conjunctiva</data>
  <data key="d1">concept</data>
  <data key="d2">Conjunctival redness is a sign of acute narrow-angle glaucoma.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="&quot;steamy&quot; edematous cornea">
  <data key="d0">"steamy" edematous cornea</data>
  <data key="d1">concept</data>
  <data key="d2">A "steamy" cornea is a sign of acute narrow-angle glaucoma.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Fixed, mid-dilated pupil">
  <data key="d0">Fixed, mid-dilated pupil</data>
  <data key="d1">concept</data>
  <data key="d2">A fixed, mid-dilated pupil is a key sign of acute narrow-angle glaucoma.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Elevated IOP">
  <data key="d0">Elevated IOP</data>
  <data key="d1">concept</data>
  <data key="d2">Elevated intraocular pressure is a defining feature of acute narrow-angle glaucoma.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Patient 50 years or older">
  <data key="d0">Patient 50 years or older</data>
  <data key="d1">concept</data>
  <data key="d2">Giant cell arteritis typically presents in patients aged 50 years or older.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Abrupt onset visual disturbances">
  <data key="d0">Abrupt onset visual disturbances</data>
  <data key="d1">concept</data>
  <data key="d2">Giant cell arteritis can cause transient monocular vision loss.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Jaw claudication">
  <data key="d0">Jaw claudication</data>
  <data key="d1">concept</data>
  <data key="d2">Jaw claudication, pain with chewing, is a symptom of giant cell arteritis.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="History of CO exposure">
  <data key="d0">History of CO exposure</data>
  <data key="d1">concept</data>
  <data key="d2">Carbon monoxide toxicity is associated with a history of exposure.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711627</data>
  <data key="d6"></data>
</node>
<node id="Others at same site affected">
  <data key="d0">Others at same site affected</data>
  <data key="d1">concept</data>
  <data key="d2">Carbon monoxide toxicity often affects others in the same environment.</data>
  <data key="d3">chunk-46a91a6ca3bd33e40fa248d0f9db07e9</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711628</data>
  <data key="d6"></data>
</node>
<node id="Ural Hematoma">
  <data key="d0">Ural Hematoma</data>
  <data key="d1">data</data>
  <data key="d2">Ural hematoma is a medical condition involving bleeding within the brain tissue.</data>
  <data key="d3">chunk-d61ad759e65d31104e19ee42ca2643f2</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711628</data>
  <data key="d6"></data>
</node>
<node id="IPH">
  <data key="d0">IPH</data>
  <data key="d1">data</data>
  <data key="d2">IPH stands for intraparenchymal hemorrhage, a type of stroke involving bleeding within the brain tissue.</data>
  <data key="d3">chunk-d61ad759e65d31104e19ee42ca2643f2</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711628</data>
  <data key="d6"></data>
</node>
<node id="IOP">
  <data key="d0">IOP</data>
  <data key="d1">data</data>
  <data key="d2">IOP stands for intraorifice pressure, a measurement related to pressure within an orifice.</data>
  <data key="d3">chunk-d61ad759e65d31104e19ee42ca2643f2</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711628</data>
  <data key="d6"></data>
</node>
<node id="ESR">
  <data key="d0">ESR</data>
  <data key="d1">data</data>
  <data key="d2">ESR stands for erythrocyte sedimentation rate, a blood test used to detect inflammation.</data>
  <data key="d3">chunk-d61ad759e65d31104e19ee42ca2643f2</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711628</data>
  <data key="d6"></data>
</node>
<node id="CRP">
  <data key="d0">CRP</data>
  <data key="d1">data</data>
  <data key="d2">CRP stands for c-reactive protein, a marker of inflammation in the body.</data>
  <data key="d3">chunk-d61ad759e65d31104e19ee42ca2643f2</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711628</data>
  <data key="d6"></data>
</node>
<node id="CO">
  <data key="d0">CO</data>
  <data key="d1">data</data>
  <data key="d2">CO stands for carbon monoxide, a colorless, odorless, and toxic gas.</data>
  <data key="d3">chunk-d61ad759e65d31104e19ee42ca2643f2</data>
  <data key="d4">iMD_Uptodate_Cannot_miss_diagnoses_in_the_ED_patient_with_acute.PDF</data>
  <data key="d5">1792711628</data>
  <data key="d6"></data>
</node>
<node id="Explosive onset and severe at onset">
  <data key="d0">Explosive onset and severe at onset</data>
  <data key="d1">concept</data>
  <data key="d2">Explosive onset and severe at onset is a clinical feature associated with headache linked to serious pathology.</data>
  <data key="d3">chunk-c843eee421b0ff9ddca5fec1a5a3934d</data>
  <data key="d4">iMD_Uptodate_Clinical_features_of_headache_associated_with_serious.PDF</data>
  <data key="d5">1792711644</data>
