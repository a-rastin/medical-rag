  <data key="d0">Sumatriptan 6 mg subcutaneous injection</data>
  <data key="d1">data</data>
  <data key="d2">Sumatriptan 6 mg subcutaneous injection is a recommended treatment option for severe migraine attacks in emergency settings.</data>
  <data key="d3">chunk-cfaea66e0e1b59fcf11083fdc86fa505</data>
