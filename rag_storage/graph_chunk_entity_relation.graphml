<edge source="CGRP Antagonists" target="Rimegepant">
  <data key="d7">1.0</data>
  <data key="d8">Rimegepant is a small-molecule CGRP antagonist (gepant) effective for acute migraine treatment.</data>
  <data key="d9">acute migraine treatment,therapeutic class</data>
  <data key="d10">chunk-d38115148b4b0478b2ff0c5f850bbcb7</data>
