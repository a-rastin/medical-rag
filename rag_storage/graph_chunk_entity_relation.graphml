<edge source="Triptans" target="Acute Cluster Headache">
  <data key="d7">1.0</data>
  <data key="d8">Triptans are a reasonable alternative for acute cluster headache when oxygen is not effective or readily available.</data>
  <data key="d9">acute treatment,therapeutic alternative</data>
