</edge>
<edge source="Suspected meningitis or encephalitis" target="IV acyclovir">
  <data key="d7">1.0</data>
  <data key="d8">IV acyclovir should be given if herpes encephalitis is a serious consideration.</data>
  <data key="d9">adjunctive treatment,herpes encephalitis</data>
  <data key="d10">chunk-d3b99ec17053435d72311359e33c6696</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
  <data key="d12">1792711772</data>
  <data key="d13"></data>
</edge>
<edge source="Suspected meningitis or encephalitis" target="IV doxycycline">
  <data key="d7">1.0</data>
  <data key="d8">IV doxycycline should be given for tick-borne diseases if serious considerations exist.</data>
  <data key="d9">adjunctive treatment,tick-borne diseases</data>
  <data key="d10">chunk-d3b99ec17053435d72311359e33c6696</data>
  <data key="d11">iMD_Uptodate_Evaluation_of_the_adult_with_nontraumatic_headache.PDF</data>
