  <data key="d10">chunk-e431a39c5b3ac9ad50817fd6694435f0</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711586</data>
  <data key="d13"></data>
</edge>
<edge source="Verapamil" target="Prednisone">
  <data key="d7">1.0</data>
  <data key="d8">Verapamil is often coadministered with a short course of prednisone during initial titration; typical regimen is prednisone 100 mg once a day for three days and then tapering by 10 mg every third day.</data>
  <data key="d9">adjunct therapy,tapering regimen</data>
  <data key="d10">chunk-2f74beccf3932fc999c5da6217dd983e</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711587</data>
  <data key="d13"></data>
</edge>
<edge source="Verapamil" target="ECG monitoring">
  <data key="d7">1.0</data>
  <data key="d8">An ECG should be obtained after each dose increment above a total daily dose of 480 mg to assess for cardiac conduction delays; some experts recommend getting a pretreatment ECG to screen for baseline cardiac arrhythmia.</data>
  <data key="d9">cardiac safety,dose monitoring</data>
  <data key="d10">chunk-2f74beccf3932fc999c5da6217dd983e</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711587</data>
  <data key="d13"></data>
</edge>
<edge source="Glucocorticoids" target="Preventive Therapy">
  <data key="d7">1.0</data>
  <data key="d8">Glucocorticoids are suggested as initial preventive therapy for episodic cluster headache with short active periods.</data>
  <data key="d9">preventing recurrent attacks,short-term prophylaxis</data>
  <data key="d10">chunk-604091b1b25ec431b6eb74ffe266e830</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711585</data>
  <data key="d13"></data>
</edge>
<edge source="Glucocorticoids" target="Prednisone">
  <data key="d7">2.0</data>
  <data key="d8">Prednisone is a glucocorticoid used for initial preventive therapy.&lt;SEP&gt;Oral prednisone is used as a short course of glucocorticoids, tapered by decreasing the dose 10 mg every third day during verapamil titration.</data>
  <data key="d9">cluster headache prevention,glucocorticoid administration,preventive therapy,tapering regimen</data>
  <data key="d10">chunk-697366b5ec6fccd401f60e32f476bcb8&lt;SEP&gt;chunk-e431a39c5b3ac9ad50817fd6694435f0</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711586</data>
  <data key="d13"></data>
</edge>
<edge source="Combination therapy" target="Prednisone">
  <data key="d7">1.0</data>
  <data key="d8">Prednisone is used in combination with verapamil for cluster headache.</data>
  <data key="d9">combination medication</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Combination therapy" target="Topiramate">
  <data key="d7">1.0</data>
  <data key="d8">Topiramate is used in combination with verapamil for cluster headache.</data>
  <data key="d9">combination medication</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Combination therapy" target="Lithium">
  <data key="d7">1.0</data>
  <data key="d8">Lithium is used in combination with verapamil for cluster headache.</data>
  <data key="d9">combination medication</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Prednisone" target="Cluster Headache">
  <data key="d7">1.0</data>
  <data key="d8">Prednisone was studied for short-term prevention of episodic cluster headache.</data>
  <data key="d9">short-term prevention</data>
  <data key="d10">chunk-0a3bc3f7fc9283c8a89abea7bd6a2953</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711580</data>
  <data key="d13"></data>
</edge>
<edge source="Topiramate" target="Lithium">
  <data key="d7">1.0</data>
  <data key="d8">Lithium and Topiramate are both used for cluster headache prevention, sometimes in combination with verapamil.</data>
  <data key="d9">cluster headache prevention,medication combination</data>
  <data key="d10">chunk-ba771d788f7481cea05e87c2e085913d</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711585</data>
  <data key="d13"></data>
</edge>
<edge source="Topiramate" target="Cluster Headache">
  <data key="d7">2.0</data>
  <data key="d8">Topiramate is an agent that may be effective as a preventive therapy for cluster headache.&lt;SEP&gt;Topiramate was studied for cluster headache prophylaxis in multiple trials.</data>
  <data key="d9">clinical trial,preventive therapy option,prophylaxis</data>
  <data key="d10">chunk-feb1965a69687b7da4c479723318f38b&lt;SEP&gt;chunk-2f74beccf3932fc999c5da6217dd983e</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711585</data>
  <data key="d13"></data>
</edge>
<edge source="Topiramate" target="Initial preventive therapies">
  <data key="d7">1.0</data>
  <data key="d8">Topiramate is an alternative medication for some patients who do not respond to initial preventive therapies.</data>
  <data key="d9">alternative therapy,cluster headache prevention</data>
  <data key="d10">chunk-697366b5ec6fccd401f60e32f476bcb8</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711586</data>
  <data key="d13"></data>
</edge>
<edge source="Lithium" target="Cluster Headache">
  <data key="d7">2.0</data>
  <data key="d8">Lithium is an agent that may be effective as a preventive therapy for cluster headache.&lt;SEP&gt;Lithium was compared with verapamil in cluster headache prophylaxis.</data>
  <data key="d9">preventive therapy option,prophylactic treatment</data>
  <data key="d10">chunk-0a3bc3f7fc9283c8a89abea7bd6a2953&lt;SEP&gt;chunk-2f74beccf3932fc999c5da6217dd983e</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711580</data>
  <data key="d13"></data>
</edge>
<edge source="Lithium" target="Episodic Cluster Headache">
  <data key="d7">1.0</data>
  <data key="d8">Lithium was studied in a double-blind placebo-controlled trial for episodic cluster headache.</data>
  <data key="d9">clinical trial,treatment efficacy</data>
  <data key="d10">chunk-feb1965a69687b7da4c479723318f38b</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711585</data>
  <data key="d13"></data>
</edge>
<edge source="Lithium" target="Initial preventive therapies">
  <data key="d7">1.0</data>
  <data key="d8">Lithium is an alternative medication for some patients who do not respond to initial preventive therapies.</data>
  <data key="d9">alternative therapy,cluster headache prevention</data>
  <data key="d10">chunk-697366b5ec6fccd401f60e32f476bcb8</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711586</data>
  <data key="d13"></data>
</edge>
<edge source="Oral ergotamine" target="Nighttime attacks">
  <data key="d7">1.0</data>
  <data key="d8">Oral ergotamine can be used as preventive treatment (evening dosage) for attacks that occur only at night.</data>
  <data key="d9">preventive treatment</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Sphenopalatine ganglion stimulation" target="Noninvasive vagus nerve stimulation">
  <data key="d7">1.0</data>
  <data key="d8">Sphenopalatine ganglion stimulation was superior to sham stimulation for pain relief and reduction in attack frequency, whereas noninvasive vagus nerve stimulation showed inconsistent evidence compared to sham.</data>
  <data key="d9">efficacy,treatment comparison</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Sphenopalatine ganglion stimulation" target="Deep brain stimulation">
  <data key="d7">2.0</data>
  <data key="d8">Deep brain stimulation is an investigational treatment for intractable cluster headache, while sphenopalatine ganglion stimulation involves surgical implantation of a neurostimulator with demonstrated efficacy in trial settings.&lt;SEP&gt;Sphenopalatine ganglion stimulation involves surgical implantation of a neurostimulator, while deep brain stimulation targets the posterior inferior hypothalamic region and carries risks such as intracerebral hemorrhage.</data>
  <data key="d9">invasiveness,treatment comparison</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Sphenopalatine ganglion stimulation" target="Cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Sphenopalatine ganglion stimulation was superior to sham stimulation for pain relief and reduction in attack frequency, though serious adverse events involved neurostimulator lead misplacement and migration.</data>
  <data key="d9">adverse events,treatment efficacy</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Episodic cluster headache" target="Prophylactic medication tapering">
  <data key="d7">1.0</data>
  <data key="d8">For patients with episodic cluster headache, prophylactic medications should be tapered after the expected duration of the cluster has passed.</data>
  <data key="d9">tapering schedule</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Chronic cluster headache" target="Dose reduction trial">
  <data key="d7">1.0</data>
  <data key="d8">For patients with chronic cluster headache who have a good response to preventive pharmacotherapy, a dose reduction trial of preventive medications every three months is suggested.</data>
  <data key="d9">every three months</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Chronic cluster headache" target="Medication restart">
  <data key="d7">1.0</data>
  <data key="d8">The drugs can be restarted at the lowest effective dose if symptoms recur.</data>
  <data key="d9">lowest effective dose</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Oxygen inhalation" target="Acute cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Oxygen inhalation is the suggested initial treatment for acute cluster headache attacks.</data>
  <data key="d9">aborting attacks,initial treatment</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711577</data>
  <data key="d13"></data>
</edge>
<edge source="Oxygen inhalation" target="Nonrebreathing facial mask">
  <data key="d7">1.0</data>
  <data key="d8">A nonrebreathing facial mask is used to administer oxygen inhalation for acute cluster headache, with a flow rate of at least 12 L/minute.</data>
  <data key="d9">administration device</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Oxygen inhalation" target="Demand valve mask">
  <data key="d7">1.0</data>
  <data key="d8">A demand valve mask may enhance the efficacy of oxygen inhalation for acute cluster headache.</data>
  <data key="d9">administration device</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Oxygen inhalation" target="Hypercapnia">
  <data key="d7">1.0</data>
  <data key="d8">Patients with severe chronic obstructive pulmonary disease should not be treated with inhaled oxygen because of the risk for developing severe hypercapnia and CO2 narcosis.</data>
  <data key="d9">contraindication,risk factor</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Oxygen inhalation" target="CO2 narcosis">
  <data key="d7">1.0</data>
  <data key="d8">Patients with severe chronic obstructive pulmonary disease should not be treated with inhaled oxygen because of the risk for developing severe hypercapnia and CO2 narcosis.</data>
  <data key="d9">contraindication,risk factor</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Acute cluster headache" target="Subcutaneous sumatriptan">
  <data key="d7">1.0</data>
  <data key="d8">Subcutaneous sumatriptan (6 mg) is beneficial for acute cluster headache, achieving pain-free status in about 75 percent of patients within 20 minutes.</data>
  <data key="d9">acute treatment,pain relief</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Acute cluster headache" target="Intranasal sumatriptan">
  <data key="d7">1.0</data>
  <data key="d8">Intranasal sumatriptan (20 mg) is effective for acute cluster headache with a higher response rate at 30 minutes compared to placebo.</data>
  <data key="d9">acute treatment,pain relief</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Acute cluster headache" target="Intranasal zolmitriptan">
  <data key="d7">1.0</data>
  <data key="d8">Intranasal zolmitriptan is another beneficial treatment option for acute cluster headache.</data>
  <data key="d9">acute treatment,pain relief</data>
  <data key="d10">chunk-9064f1ec2a51a8fb5fc12ef54afba305</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Pizotifen" target="Cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Pizotifen has only a modest effect and is limited by side effects such as tiredness and weight gain in treating cluster headache.</data>
  <data key="d9">side effects,treatment efficacy</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Pizotifen" target="Vascular Headaches">
  <data key="d7">1.0</data>
  <data key="d8">Pizotifen was reviewed for its pharmacological properties and therapeutic efficacy in vascular headaches.</data>
  <data key="d9">pharmacological properties,therapeutic efficacy</data>
  <data key="d10">chunk-feb1965a69687b7da4c479723318f38b</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711585</data>
  <data key="d13"></data>
</edge>
<edge source="Valproate" target="Cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Valproate has conflicting evidence for utility in cluster headache prophylaxis and can be used in a dose between 5 and 20 mg/kg daily.</data>
  <data key="d9">dosage,treatment efficacy</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Capsaicin" target="Cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Capsaicin was reported to be effective in approximately two-thirds of patients with cluster headache, though its use is uncertain due to induction of pain, sneezing, and nasal secretions.</data>
  <data key="d9">administration route,treatment efficacy</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711578</data>
  <data key="d13"></data>
</edge>
<edge source="Capsaicin" target="Cluster Headache">
  <data key="d7">1.0</data>
  <data key="d8">Capsaicin application to the nasal mucosa was studied for its beneficial effect in cluster headache.</data>
  <data key="d9">nasal mucosa,treatment application</data>
  <data key="d10">chunk-feb1965a69687b7da4c479723318f38b</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711586</data>
  <data key="d13"></data>
</edge>
<edge source="Melatonin" target="Cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Oral melatonin (10 mg) was more effective than placebo but had a relatively low response rate (5 of 10 patients), and adjunctive melatonin did not produce benefit in refractory cases.</data>
  <data key="d9">dosage,treatment efficacy</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Botulinum toxin" target="Cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Limited, low-quality data suggest that botulinum toxin injections have benefit for some patients with chronic cluster headache.</data>
  <data key="d9">quality of evidence,treatment efficacy</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Hyperbaric oxygen" target="Cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Hyperbaric oxygen was found ineffective in preventing cluster headache attacks in a small placebo-controlled, double-blind trial.</data>
  <data key="d9">treatment efficacy</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Noninvasive vagus nerve stimulation" target="Deep brain stimulation">
  <data key="d7">1.0</data>
  <data key="d8">Noninvasive vagus nerve stimulation is a non-surgical method, whereas deep brain stimulation requires surgical implantation and carries risks such as intracerebral hemorrhage.</data>
  <data key="d9">invasiveness,treatment comparison</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Noninvasive vagus nerve stimulation" target="Cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Noninvasive vagus nerve stimulation may reduce the frequency of cluster headache attacks, but evidence is inconsistent between open-label and double-blind randomized trials.</data>
  <data key="d9">evidence consistency,treatment efficacy</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Deep brain stimulation" target="Cluster headache">
  <data key="d7">1.0</data>
  <data key="d8">Deep brain stimulation is associated with a 77 percent mean reduction of headache frequency among responders, but carries risks such as intracerebral hemorrhage and requires stringent patient selection criteria.</data>
  <data key="d9">risks,treatment efficacy</data>
  <data key="d10">chunk-075c9514b73c9528ed6f8491b449ee40</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Cocaine" target="Cluster Headache">
  <data key="d7">1.0</data>
  <data key="d8">Cocaine was studied in relation to its effects on nitroglycerin-induced cluster headache attacks.</data>
  <data key="d9">substance study,treatment</data>
  <data key="d10">chunk-0a3bc3f7fc9283c8a89abea7bd6a2953</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Nitroglycerin" target="Cluster Headache">
  <data key="d7">1.0</data>
  <data key="d8">Nitroglycerin is used to induce cluster headache attacks in research settings.</data>
  <data key="d9">induction,research method</data>
  <data key="d10">chunk-0a3bc3f7fc9283c8a89abea7bd6a2953</data>
  <data key="d11">iMD - Uptodate - Cluster headache_ Treatment and prognosis.PDF</data>
  <data key="d12">1792711579</data>
  <data key="d13"></data>
</edge>
<edge source="Ergotamine Tartrate" target="Cluster Headache">
  <data key="d7">1.0</data>
  <data key="d8">Ergotamine tartrate was studied orally in Horton's histaminic cephalalgia.</data>
